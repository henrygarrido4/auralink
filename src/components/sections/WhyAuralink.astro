---
import Mark from '@/assets/aura-hero.svg';
import Icon from '@/components/ui/Icon.astro';
import { whyPillars } from '@/data/site';

/**
 * Home page "Why Auralink Studio?", directly under the services and before who we work with.
 * The copy is the owner's: an eyebrow, one heading, one sentence, and exactly three cards
 * (`whyPillars`, src/data/site.ts). The sentence and the middle card were rewritten by the owner
 * on 2026-11-20; the eyebrow, heading, and the other two cards are from the approved mockup of
 * 2026-11-19. No button, link, price, or badge, and nothing is clickable.
 *
 * The cards follow the "Why choose us" cards of the Troma demo (demo.casethemes.net/troma), the
 * owner's reference (2026-11-20), in this site's colours, and since 2026-11-21 they are a dark
 * tone: three alike, `card-shine` (src/styles/global.css), a dark mix of `neutral` with white, soft
 * corners, no border or shadow, generous padding, and light text. The yellow centre card of the
 * mockup went with the Troma cards, since one card standing yellow at rest would read as hovered.
 * The icon tile and the check discs stay near-black with yellow glyphs, the pairing of the lead
 * service card, which still reads on the lighter dark of the card. The icons and marks are
 * decorative.
 *
 * Hover (the owner's choice, 2026-11-21, the premium card shine,
 * https://www.youtube.com/shorts/RojcPDSd63k, in place of the border light the cards had before):
 * a streak of light sweeps across the card. `card-shine` parks that band off the card's left edge;
 * under a fine pointer that can hover it crosses the card, and when the pointer leaves it fades
 * out where it is and returns to its parking place unseen, so a pointer passing through never
 * sees it vanish. The band moves on the compositor (`translate` and `opacity`), so the sweep
 * costs the page nothing per frame. Nothing on the card moves or changes colour. Under reduced
 * motion, and on a coarse pointer, the band stays parked.
 *
 * The band is flat `neutral` (the owner asked for a cleaner background than the desk photograph
 * that was here, 2026-11-20, so the photograph was removed from the repository with its credit),
 * with the owner's mark (src/assets/aura-hero.svg, in the viewBox that ends at the artwork, as
 * the inner-page hero draws it) laid faint twice from lg, in `primary` at a tenth: the owner's
 * request for the logo about the section (2026-11-20), then for a second one at the bottom left.
 * The first fills the band's top right corner, whole, sized so it stays right of the sentence's
 * measure and above the cards at every width from lg. The second rises from the band's bottom
 * left corner with its lower half past the edge, which the band clips, as the detail pages' mark
 * rests on a band's bottom edge; the band pads to `lg:pb-36` so the visible half meets no card.
 * The two sit on a diagonal, so the band reads as one composition. Both are decorative, behind
 * the copy and the cards, inside the screen (the layout suite fails any box past the viewport),
 * and not drawn below lg, where the copy could run under the first.
 *
 * The introduction sits on the container's left edge, like the other sections (the owner asked
 * for the header left-aligned where the reference centres it): the eyebrow, the heading, a short
 * primary rule, and the sentence at a readable measure (`max-w-2xl`). Inside the cards the copy
 * is left-aligned too, which keeps the checklists readable. From lg the cards share one row and
 * a subgrid, so the icon, the category, the two-line heading, the description, and the checklist
 * each line up across the three cards however the description wraps, and every card uses the
 * same padding: 32px from lg, so "Measurable progress." stays on one line, and 48px from xl,
 * where the cards are wider. Below lg they stack in the same order, only as tall as their own
 * text. No client-side JavaScript.
 */
interface Props {
  /** Anchor for in-page links. */
  id: string;
}

const { id } = Astro.props;
const titleId = `${id}-title`;
---

<section
  id={id}
  aria-labelledby={titleId}
  class="relative isolate overflow-clip bg-neutral text-neutral-content"
>
  {/*
   * Both 24% of the viewport wide between 14rem and 25rem. The first is held in the top right
   * corner: at 1024px that is 246px, inside the 288px between the sentence's measure and the
   * screen's edge, and 172px tall, well above the cards. The second is held in the bottom left
   * corner and moved down by half its height, so its upper half shows: 140px at most (the mark is
   * 0.7 times as tall as it is wide), inside the band's 144px bottom padding from lg. The paths
   * of each take the tint set here.
   */}
  <Mark
    data-why-mark="top"
    class="pointer-events-none absolute top-0 right-0 -z-10 hidden h-auto w-[clamp(14rem,24vw,25rem)] text-primary/10 **:fill-current lg:block"
    viewBox="0 225 1500 1050"
    width="1500"
    height="1050"
    aria-hidden="true"
    focusable="false"
  />
  <Mark
    data-why-mark="bottom"
    class="pointer-events-none absolute bottom-0 left-0 -z-10 hidden h-auto w-[clamp(14rem,24vw,25rem)] translate-y-1/2 text-primary/10 **:fill-current lg:block"
    viewBox="0 225 1500 1050"
    width="1500"
    height="1050"
    aria-hidden="true"
    focusable="false"
  />

  <div class="mx-auto max-w-site px-6 pt-16 pb-16 sm:pt-20 sm:pb-20 lg:px-8 lg:pt-24 lg:pb-36 xl:pt-28">
    {/*
     * The shared eyebrow locks a dark colour for the light sections. Here the label is the
     * primary yellow, so it is set directly, with the same size and tracking. It, the heading,
     * the rule, and the sentence start on this container's left edge, the same edge as the cards.
     */}
    <p class="text-sm font-bold tracking-[0.16em] text-primary uppercase">How we're different</p>
    <h2
      id={titleId}
      class="mt-4 text-3xl font-bold tracking-tight text-balance sm:mt-5 sm:text-4xl xl:text-5xl"
    >
      <span class="font-light">Why</span> Auralink Studio?
    </h2>
    <div class="mt-5 h-0.5 w-12 bg-primary" aria-hidden="true"></div>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-pretty sm:mt-6">
      Thoughtful websites. Built for performance. A partner invested in your business.
    </p>

    {/*
     * role="list": Safari drops the list role from lists styled without markers.
     * Three columns from lg. The row gap is the space between a card's icon, category, heading,
     * description, and checklist, shared through the subgrid, which runs through the list item
     * into the card. In forced colours the fill is dropped, so the card keeps an edge.
     */}
    <ul
      role="list"
      class="mt-12 grid gap-6 sm:mt-14 lg:mt-16 lg:grid-cols-3 lg:gap-x-6 lg:gap-y-5 xl:mt-20 xl:gap-x-7"
    >
      {whyPillars.map((pillar) => (
        <li class="grid lg:row-span-5 lg:grid-rows-subgrid">
          <div
            data-why-card
            class="card-shine grid min-w-0 grid-rows-[auto_auto_auto_auto_auto] gap-5 rounded-lg p-8 text-left text-base-100 forced-colors:border sm:p-10 lg:row-span-5 lg:grid-rows-subgrid lg:gap-y-5 lg:p-8 xl:p-12"
          >
            {/* A little more room under the tile than between the lines of copy. */}
            <span
              data-why-icon
              class="mb-1 grid size-14 place-items-center rounded-md bg-neutral text-primary"
              aria-hidden="true"
            >
              <Icon name={pillar.icon} class="size-7" stroke-width="1.75" />
            </span>
            <p class="text-xs font-bold tracking-[0.14em] text-neutral-content uppercase sm:text-sm">
              {pillar.category}
            </p>
            <h3 class="text-2xl leading-tight font-bold tracking-tight sm:text-3xl lg:text-2xl xl:text-[2rem] xl:leading-tight">
              <span class="block">{pillar.title[0]}</span>{' '}
              <span class="block">{pillar.title[1]}</span>
            </h3>
            <p class="text-base leading-relaxed text-pretty text-neutral-content/90">
              {pillar.description}
            </p>
            {/* The hairline is white at 15%, which shows on the dark card. */}
            <ul role="list" data-why-points class="grid gap-3 border-t border-base-100/15 pt-5">
              {pillar.points.map((point) => (
                <li class="flex items-start gap-3">
                  <span
                    class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-neutral text-primary"
                    aria-hidden="true"
                  >
                    <Icon name="check" class="size-3" stroke-width="3" />
                  </span>
                  <span class="min-w-0 text-base leading-snug font-medium lg:text-sm xl:text-base">
                    {point}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
