---
import DetailSection from '@/components/sections/DetailSection.astro';
import BrowserFrame from '@/components/ui/BrowserFrame.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { serviceCardById } from '@/data/detail-pages';
import { ownSiteCta, servicesHeadingOf, statusOf, type WorkProject } from '@/data/work';

/**
 * One project on the work page. The content is the owner's brief of 2026-11-21 (after the
 * results page of Eyler Creative: the challenge, the solution, what we manage, and no results,
 * since the owner has none to publish); the layout is the redesign of 2026-11-26, after a look at
 * how studios present a project in 2026 (the showcase panels of product sites, the facts kept to
 * a small row, the picture large and the captions small, the story in short columns), in this
 * site's own system. Each project is two parts on the white band.
 *
 * The showcase panel: a large rounded panel in the home process band's charcoal with its fine
 * lines (`process-lines bg-neutral/90`, so every dark surface on the site is the same one), on
 * every project (the owner, 2026-11-26, in place of the white aura panel that odd projects had
 * for the first hours of the redesign). From lg the copy takes five columns and the site's own
 * homepage in a browser window (BrowserFrame.astro) seven, centred beside it and lifted by a deep
 * shadow, on the right of even projects and the left of odd ones, so the page still alternates;
 * below lg the headline comes first, then the window, then the lead and the button, which is the
 * order of the markup (the grid places the three blocks from lg). Across the panel's foot, behind
 * a hairline, the three things a visitor can see on the site, each with a Lucide icon on a
 * frosted tile. The copy is the project's number (decorative, in `primary`, as the dark bands'
 * numbers), how it is built and its status (a concept, since none of the three businesses is a
 * client, the owner said on 2026-11-26, or our own website), the name as the section's h2, the
 * kind of business and where it is, the lead paragraph, and the button: the secondary's white
 * mirror (`inverse`, with the navbar's light focus ring), which opens the site in a new tab;
 * visually hidden words complete its name with the project and the new tab. The studio's own
 * website (`ownSite`, 2026-11-26) ends instead with a line and the same button inviting a call,
 * in the same tab.
 *
 * The story: three columns under the panel from lg, each opened by a hairline and an h3 that every
 * project shares: the challenge, the solution (a paragraph, or the choices as a list with the
 * invitation's check marks), and the services, each a link to its page, under "What we'd manage"
 * on a concept and "What we manage" on our own website (`servicesHeadingOf`). No client result,
 * figure, or testimonial is stated anywhere. Nothing here moves on load, and no colour fades.
 */
interface Props {
  project: WorkProject;
  /** Its place among the projects, counted from 0; sets the number and the window's side. */
  index: number;
}

const { project, index } = Astro.props;
const id = project.id;
const titleId = `${id}-title`;
const number = String(index + 1).padStart(2, '0');
/** Even projects put the window at the right of the copy; odd ones mirror that. */
const flipped = index % 2 === 1;
const services = project.services.map((card) => serviceCardById(card));

const label = 'flex items-center gap-3 text-sm font-bold tracking-[0.16em] uppercase';
const dash = 'h-0.5 w-6 shrink-0 bg-primary';
const copy = flipped ? 'lg:col-start-8' : 'lg:col-start-1';
---

<DetailSection id={id} labelledBy={titleId}>
  <div
    data-work-panel
    class="process-lines rounded-2xl bg-neutral/90 p-6 text-neutral-content sm:p-8 lg:p-12"
  >
    {/*
     * From lg the copy's two blocks sit in the middle rows of four, between two rows that share
     * whatever height the window has to spare, so a short copy (the studio's own website) is
     * centred beside the window, and a tall one lets the window centre beside it instead.
     */}
    <div class="grid gap-y-8 lg:grid-cols-12 lg:grid-rows-[1fr_auto_auto_1fr] lg:gap-x-12 lg:gap-y-0">
      <div class:list={['min-w-0 lg:col-span-5 lg:row-start-2', copy]}>
        {/* Decorative: the index above and the name below already place the project. */}
        <p
          class="font-(family-name:--font-headers) text-5xl leading-none font-bold tracking-tight text-primary sm:text-6xl"
          aria-hidden="true"
        >
          {number}.
        </p>
        <p class:list={['mt-6 flex-wrap gap-y-2 text-neutral-content/80', label]}>
          <span class={dash} aria-hidden="true"></span>
          <span>{project.platform}</span>
          <span class="rounded-full border border-neutral-content/30 px-2.5 py-0.5 text-xs tracking-[0.12em]">
            {statusOf(project)}
          </span>
        </p>
        <h2
          id={titleId}
          class="mt-4 text-3xl leading-tight font-bold tracking-tight text-balance text-base-100 sm:text-4xl xl:text-5xl"
        >
          {project.name}
        </h2>
        <p class="mt-3 text-base font-bold text-neutral-content/70">
          {project.location ? `${project.industry} · ${project.location}` : project.industry}
        </p>
      </div>

      <div
        class:list={[
          'min-w-0 lg:col-span-7 lg:row-span-4 lg:row-start-1 lg:self-center',
          flipped ? 'lg:col-start-1' : 'lg:col-start-6',
        ]}
      >
        {/*
         * `sizes`: the window's width inside the container's padding and the panel's (24px each
         * side below sm, 32px from sm, 48px from lg): the full width below lg, then seven twelfths
         * of what the column gap (48px) leaves, capped with the 88rem container from 1408px.
         */}
        <BrowserFrame
          project={project}
          crop="full"
          sizes="(min-width: 1408px) 700px, (min-width: 1024px) calc((100vw - 208px) * 7 / 12), (min-width: 640px) calc(100vw - 112px), calc(100vw - 96px)"
          class="rounded-lg border border-base-100/15 shadow-2xl"
        />
      </div>

      <div class:list={['min-w-0 lg:col-span-5 lg:row-start-3 lg:mt-6', copy]}>
        <p class="max-w-2xl text-lg leading-relaxed text-pretty text-neutral-content/85">
          {project.description}
        </p>
        {/*
         * The outlined button (the owner, 2026-11-21, in place of the lit primary), in white for
         * the dark panel: a pill outline that fills white under the pointer, at once, with the
         * navbar's light ring on keyboard focus.
         */}
        <div class="mt-8">
          {project.ownSite ? (
            <>
              <p class="text-lg leading-snug font-bold text-pretty">{ownSiteCta.lead}</p>
              <Button
                href={ownSiteCta.href}
                size="lg"
                variant="inverse"
                class="mt-5 transition-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-content"
              >
                {ownSiteCta.label}
                <Icon name="arrow-right" class="size-5" />
              </Button>
            </>
          ) : (
            <Button
              href={project.link.href}
              target="_blank"
              rel="noopener"
              size="lg"
              variant="inverse"
              class="transition-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-content"
            >
              {project.link.label}
              <span class="sr-only">, {project.name}, opens in a new tab</span>
              <Icon name="arrow-up-right" class="size-5" />
            </Button>
          )}
        </div>
      </div>
    </div>

    {/* role="list": Safari drops the list role from lists styled without markers. */}
    <ul
      role="list"
      class="mt-10 grid gap-6 border-t border-base-100/15 pt-8 sm:grid-cols-3 lg:mt-12"
    >
      {project.features.map((feature) => (
        <li class="flex min-w-0 items-start gap-3">
          <span
            class="grid size-10 shrink-0 place-items-center rounded-md bg-base-100/10 text-primary"
            aria-hidden="true"
          >
            <Icon name={feature.icon} class="size-5" stroke-width="1.75" />
          </span>
          <span class="min-w-0 pt-0.5 text-sm leading-snug font-bold">{feature.text}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="mt-12 grid gap-10 lg:mt-16 lg:grid-cols-12 lg:gap-x-12">
    <div class="min-w-0 border-t border-base-300 pt-8 lg:col-span-4">
      <h3 class:list={[label, 'text-base-content/70']}>
        <span class={dash} aria-hidden="true"></span>
        The challenge
      </h3>
      <p class="mt-4 text-base leading-relaxed text-pretty text-base-content">
        {project.challenge}
      </p>
    </div>
    <div class="min-w-0 border-t border-base-300 pt-8 lg:col-span-5">
      <h3 class:list={[label, 'text-base-content/70']}>
        <span class={dash} aria-hidden="true"></span>
        The solution
      </h3>
      {typeof project.solution === 'string' ? (
        <p class="mt-4 text-base leading-relaxed text-pretty text-base-content">
          {project.solution}
        </p>
      ) : (
        <ul role="list" class="mt-4 grid gap-3.5">
          {project.solution.map((choice) => (
            <li class="flex items-start gap-3 text-base leading-relaxed text-base-content">
              <span
                class="mt-1 grid size-5 shrink-0 place-items-center rounded-full bg-primary text-primary-content"
                aria-hidden="true"
              >
                <Icon name="check" class="size-3" stroke-width="3" />
              </span>
              <span class="min-w-0 text-pretty">
                <strong class="font-bold">{choice.title}:</strong> {choice.text}
              </span>
            </li>
          ))}
        </ul>
      )}
    </div>
    <div class="min-w-0 border-t border-base-300 pt-8 lg:col-span-3">
      <h3 class:list={[label, 'text-base-content/70']}>
        <span class={dash} aria-hidden="true"></span>
        {servicesHeadingOf(project)}
      </h3>
      {/*
       * One pill per service, linking to its page; the icon is the service card's. Hover fills
       * near-black at once, with no fade, as the detail pages' states change.
       */}
      <ul role="list" class="mt-4 flex flex-wrap gap-2.5">
        {services.map((card) => (
          <li>
            <a
              href={card.href}
              class="inline-flex min-h-11 items-center gap-2 rounded-full border border-base-300 bg-base-100 px-4 py-2 text-sm font-bold text-base-content hover:border-neutral hover:bg-neutral hover:text-neutral-content focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral"
            >
              <Icon name={card.icon} class="size-4 shrink-0" stroke-width="2" />
              {card.title}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</DetailSection>
