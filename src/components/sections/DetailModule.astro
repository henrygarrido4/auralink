---
import DetailSection from '@/components/sections/DetailSection.astro';
import ModuleComparison from '@/components/ui/ModuleComparison.astro';
import ModuleDirectory from '@/components/ui/ModuleDirectory.astro';
import ModuleExample from '@/components/ui/ModuleExample.astro';
import ModuleJourney from '@/components/ui/ModuleJourney.astro';
import ModuleNote from '@/components/ui/ModuleNote.astro';
import ModulePaths from '@/components/ui/ModulePaths.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import type { Module } from '@/data/detail-pages';

/**
 * The distinctive module of an industry or service detail page: the one section that gives the
 * page its own structure, composed from the blocks in src/data/detail-pages.ts (pathways, a
 * journey, a directory, a comparison, a note, an example). The other sections support it rather
 * than repeat it. Blocks stack with generous space between them; every block heading is an h3
 * under the section's h2, and a block's own items go one level down. Plain HTML.
 */
interface Props {
  id: string;
  module: Module;
  /** The edge of this band the shared logo mark is centred on, if it carries one. */
  mark?: 'top' | 'bottom';
}

const { id, module, mark } = Astro.props;
const titleId = `${id}-title`;
---

<DetailSection id={id} labelledBy={titleId} mark={mark}>
  <SectionHeading
    id={titleId}
    eyebrow={module.eyebrow}
    heading={module.heading}
    intro={module.intro}
  />
  <div class="mt-12 grid gap-16 sm:mt-14 lg:gap-20">
    {module.blocks.map((block) => {
      switch (block.kind) {
        case 'paths':
          return <ModulePaths block={block} />;
        case 'journey':
          return <ModuleJourney block={block} />;
        case 'directory':
          return <ModuleDirectory block={block} />;
        case 'comparison':
          return <ModuleComparison block={block} />;
        case 'note':
          return <ModuleNote block={block} />;
        case 'example':
          return <ModuleExample block={block} />;
      }
    })}
  </div>
</DetailSection>
