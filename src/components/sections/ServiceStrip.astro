---
import { serviceCards } from '@/data/site';

/**
 * Home page services strip, directly below the hero and above the introduction. Its look follows
 * the band under the hero of the reference the owner sent on 2026-11-18: a full-width band in the
 * primary yellow with the names in near-black, over a second band in the navbar's neutral, tilted
 * so that it shows above the yellow on the right and below it on the left. The names run off both
 * edges of the screen. The section's upper half carries on the hero's background and its lower
 * half the page's, so the change between them hides behind the yellow. The service-card titles
 * are set as a line of type in the heading face: the first word bold, the rest light, with the
 * reference's eight-point asterisk between one name and the next (owner, 2026-11-18). Lucide has
 * no mark of that shape (its asterisk is six strokes), so the divider is drawn here. High Scale
 * Media's repeating services line is the content idea only: these are Auralink's own
 * capabilities, from `serviceCards`, not clients, partners, or certifications, and they are labels
 * rather than links.
 *
 * The tilt and the motion are the `service-strip` utility (src/styles/global.css): two equal
 * halves travel by half the track, so the loop and its spacing meet. src/lib/service-strip.ts sets
 * the speed and repeats a set until the band fills the screen. The names hold still while the
 * pointer is over the band and move on when it leaves; there is no pause button (owner,
 * 2026-11-18). The stylesheet alone, and the noscript block, show every name in a wrapping row.
 * Reduced motion does the same and never starts the animation. The repeated half and every
 * asterisk are hidden from assistive technology.
 */
const halves = [{ clone: false }, { clone: true }] as const;

/** "Email & Automation" becomes a bold "Email" and a light " & Automation"; "SEO" is all bold. */
const split = (title: string) => {
  const space = title.indexOf(' ');
  return space < 0
    ? { lead: title, rest: '' }
    : { lead: title.slice(0, space), rest: title.slice(space) };
};
---

<section
  data-service-strip
  aria-labelledby="service-strip-title"
  class="service-strip bg-linear-to-b from-base-200 from-50% to-base-100 to-50%"
>
  <h2 id="service-strip-title" class="sr-only">
    Services
  </h2>
  {/* The tilted band behind the yellow one. The utility cuts its shape. */}
  <div data-service-strip-tilt class="bg-neutral"></div>
  <div data-service-strip-viewport class="bg-primary py-5 text-primary-content sm:py-7">
    <div data-service-strip-track>
      {halves.map(({ clone }) => (
        <div
          data-service-strip-half
          {...(clone ? { 'data-service-strip-clone': true, 'aria-hidden': 'true' } : {})}
          class:list={[clone && 'select-none']}
        >
          <ul data-service-strip-list {...(clone ? { 'aria-hidden': 'true' } : { role: 'list' })}>
            {serviceCards.map((card) => {
              const { lead, rest } = split(card.title);
              return (
                /*
                 * Asterisk, gap, name, inside equal side padding that adds up to the same gap.
                 * So an asterisk sits midway between two names, the join between the two halves
                 * matches the spacing inside a half, and a wrapped row stays centred.
                 */
                <li class="flex items-center gap-12 px-6 font-(family-name:--font-headers) text-2xl leading-none font-light tracking-tight whitespace-nowrap sm:gap-20 sm:px-10 sm:text-3xl">
                  {/*
                   * Eight-point asterisk from the reference band: a cross and the same cross
                   * turned 45 degrees, with round ends. Drawn here rather than taken from Lucide.
                   */}
                  <svg
                    class="size-6 shrink-0 sm:size-7"
                    viewBox="0 0 16 16"
                    fill="currentColor"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <rect x="7.05" y="1.35" width="1.9" height="13.3" rx="0.95"></rect>
                    <rect x="1.35" y="7.05" width="13.3" height="1.9" rx="0.95"></rect>
                    <rect
                      x="7.05"
                      y="1.35"
                      width="1.9"
                      height="13.3"
                      rx="0.95"
                      transform="rotate(45 8 8)"
                    ></rect>
                    <rect
                      x="1.35"
                      y="7.05"
                      width="13.3"
                      height="1.9"
                      rx="0.95"
                      transform="rotate(45 8 8)"
                    ></rect>
                  </svg>
                  <span data-service-strip-label>
                    <span class="font-bold">{lead}</span>
                    {rest}
                  </span>
                </li>
              );
            })}
          </ul>
          <div data-service-strip-pad aria-hidden="true" class="select-none"></div>
        </div>
      ))}
    </div>
  </div>
  {/*
    Scripts off: the no-preference rules would leave a single clipped line. These repeat the
    utility's static row and win by source order. is:inline keeps Astro from bundling them into
    the stylesheet, where they would stop the marquee for everyone.
  */}
  <noscript>
    <style is:inline>
      .service-strip [data-service-strip-list] {
        flex-wrap: wrap;
        justify-content: center;
        width: auto;
        row-gap: calc(var(--spacing) * 5);
      }
      .service-strip [data-service-strip-half] {
        display: block;
        width: auto;
      }
      .service-strip [data-service-strip-clone],
      .service-strip [data-service-strip-pad] {
        display: none;
      }
      .service-strip [data-service-strip-viewport] {
        overflow: visible;
      }
      .service-strip [data-service-strip-track] {
        display: block;
        width: auto;
        animation: none;
      }
    </style>
  </noscript>
</section>

<script>
  import { startServiceStrip } from '@/lib/service-strip';

  for (const strip of document.querySelectorAll<HTMLElement>('[data-service-strip]')) {
    startServiceStrip(strip);
  }
</script>
