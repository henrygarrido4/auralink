---
import DetailSection from '@/components/sections/DetailSection.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { formatPrice, packagesSection, pricingInquiry, pricingPackages } from '@/data/pricing';

/**
 * The three website packages of the pricing page (src/data/pricing.ts, the owner's brief of
 * 2026-11-20), as equal-height cards on the grey band: Starter and Growth white with the detail
 * pages' hairline edge, Business in the middle on the secondary near-black with a primary "Most
 * popular" badge on its top edge. Each card is the package's name, its one-time price with the
 * note that hosting is separate, who it is for, a checklist of what is included, the estimated
 * delivery, what is not included, and, held to the foot of the card so the three buttons line up,
 * its call to action: the lit primary on the dark card, the near-black outline on the light ones.
 * Every button leads to the inquiry page; nothing is sold here. The note under the cards is the
 * brief's. Plain HTML.
 */
interface Props {
  id: string;
}

const { id } = Astro.props;
const titleId = `${id}-title`;
---

<DetailSection id={id} labelledBy={titleId} tone="muted">
  <SectionHeading
    id={titleId}
    eyebrow={packagesSection.eyebrow}
    heading={packagesSection.heading}
    intro={packagesSection.intro}
  />

  {/* role="list": Safari drops the list role from lists styled without markers. */}
  <ul role="list" class="mt-12 grid gap-6 sm:mt-14 lg:grid-cols-3 xl:gap-8">
    {pricingPackages.map((pkg) => {
      const dark = !!pkg.featured;
      const muted = dark ? 'text-secondary-content/75' : 'text-base-content/75';
      const rule = dark ? 'border-secondary-content/15' : 'border-base-300';
      return (
        <li
          data-package={pkg.id}
          class:list={[
            'relative flex min-w-0 flex-col rounded-md p-6 sm:p-8',
            dark
              ? 'bg-secondary text-secondary-content shadow-lg'
              : 'detail-card text-base-content',
          ]}
        >
          {dark && (
            <p class="absolute -top-3.5 left-6 rounded-full bg-primary px-4 py-1.5 text-xs font-bold tracking-[0.14em] text-primary-content uppercase sm:left-8">
              Most popular
            </p>
          )}
          <h3 class="text-sm font-bold tracking-[0.16em] uppercase">{pkg.name}</h3>
          <p class="mt-4 flex flex-wrap items-baseline gap-x-2">
            <span class="font-(family-name:--font-headers) text-5xl leading-none font-bold tracking-tight">
              {formatPrice(pkg.price)}
            </span>
            <span class:list={['text-sm', muted]}>{packagesSection.priceNote}</span>
          </p>
          <p class="mt-5 text-base leading-relaxed text-pretty">{pkg.audience}</p>

          <ul
            role="list"
            class:list={['mt-6 grid gap-3 border-t pt-6 sm:grid-cols-2 lg:grid-cols-1', rule]}
          >
            {pkg.features.map((feature) => (
              <li class="flex items-start gap-3 text-base leading-snug">
                <span
                  class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-primary text-primary-content"
                  aria-hidden="true"
                >
                  <Icon name="check" class="size-3" stroke-width="3" />
                </span>
                <span class="min-w-0">{feature}</span>
              </li>
            ))}
          </ul>

          <p class="mt-5 flex items-start gap-3 text-base leading-snug">
            <Icon name="clock" class="mt-0.5 size-5 shrink-0 text-primary" stroke-width="2" />
            <span class="min-w-0">
              {/* The explicit space keeps the label and the range apart in the paragraph's text. */}
              <span class="font-bold">Estimated delivery:</span> {pkg.delivery}
            </span>
          </p>

          <p class:list={['mt-5 border-t pt-5 text-sm leading-relaxed text-pretty', rule, muted]}>
            <span class:list={['font-bold', dark ? 'text-secondary-content' : 'text-base-content']}>
              Not included:
            </span>{' '}
            {pkg.excluded}
          </p>

          {/*
           * The button sits at the foot of every card, whatever the list above it holds. The lit
           * primary only on the dark card, where the aura takes the card's white text; a
           * near-black focus ring on the light cards, where the button's own yellow ring is 1.4:1.
           */}
          <div class="mt-auto pt-8">
            {dark ? (
              <Button
                href={pricingInquiry.href}
                block
                aura="hover"
                class="focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary-content"
              >
                {pkg.cta}
              </Button>
            ) : (
              <Button href={pricingInquiry.href} variant="secondary" block>
                {pkg.cta}
              </Button>
            )}
          </div>
        </li>
      );
    })}
  </ul>

  <p class="mt-8 flex max-w-3xl items-start gap-3 text-sm leading-relaxed text-pretty text-base-content/75">
    <Icon name="circle-alert" class="mt-0.5 size-4 shrink-0" />
    <span>{packagesSection.note}</span>
  </p>
</DetailSection>
