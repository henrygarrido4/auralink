---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import type { Challenges } from '@/data/detail-pages';

/**
 * An industry page's three problem-and-response rows. Each row pairs the problem, on the left
 * with its number and what it looks like on the website, with the studio's response on the
 * right, so the pair reads together and stacks together on a phone. Hairline rules part the rows;
 * nothing is a card. Plain HTML.
 */
interface Props {
  id: string;
  challenges: Challenges;
}

const { id, challenges } = Astro.props;
const titleId = `${id}-title`;
const number = (index: number) => String(index + 1).padStart(2, '0');
---

<section id={id} aria-labelledby={titleId} class="bg-base-100">
  <div class="mx-auto max-w-site px-6 py-16 sm:py-20 lg:px-8 lg:py-24">
    <SectionHeading
      id={titleId}
      eyebrow="What gets in the way"
      heading={challenges.heading}
      intro={challenges.intro}
    />

    {/* role="list": Safari drops the list role from lists styled without markers. */}
    <ol role="list" class="mt-12 border-b border-base-300 sm:mt-14">
      {challenges.items.map((challenge, index) => (
        <li class="grid gap-6 border-t border-base-300 py-8 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] md:gap-12 lg:py-10">
          <div class="min-w-0">
            <p
              class="font-(family-name:--font-headers) text-sm font-bold tracking-[0.16em] text-base-content/70"
              aria-hidden="true"
            >
              {number(index)}
            </p>
            <h3 class="mt-2 text-2xl font-bold tracking-tight text-balance text-base-content">
              {challenge.problem}
            </h3>
            <p class="mt-3 max-w-md text-base leading-relaxed text-base-content/75">
              {challenge.symptom}
            </p>
          </div>
          <div class="min-w-0 md:pt-1">
            <p class="text-sm font-bold tracking-[0.16em] text-base-content/70 uppercase">
              How we'd respond
            </p>
            <p class="mt-3 max-w-2xl text-lg leading-relaxed text-pretty text-base-content">
              {challenge.response}
            </p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
