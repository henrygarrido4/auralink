---
import DetailSection from '@/components/sections/DetailSection.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import type { Challenges } from '@/data/detail-pages';

/**
 * An industry page's three problem-and-response pairs, on the dark band (the design pass of
 * 2026-11-20). Each pair is one card in two halves: the problem on the left, in the dark, with
 * its primary number and what it looks like on the website; the studio's response on the right,
 * on white, so the answer is the lit half. The halves sit side by side from md and stack below,
 * the problem first, so the pair reads together either way. Plain HTML.
 */
interface Props {
  id: string;
  challenges: Challenges;
  /** The edge of this band the shared logo mark is centred on, if it carries one. */
  mark?: 'top' | 'bottom';
}

const { id, challenges, mark } = Astro.props;
const titleId = `${id}-title`;
const number = (index: number) => String(index + 1).padStart(2, '0');
---

<DetailSection id={id} labelledBy={titleId} tone="dark" mark={mark}>
  <SectionHeading
    id={titleId}
    eyebrow="What gets in the way"
    heading={challenges.heading}
    intro={challenges.intro}
    tone="dark"
  />

  {/* role="list": Safari drops the list role from lists styled without markers. */}
  <ol role="list" class="mt-12 grid gap-6 sm:mt-14">
    {challenges.items.map((challenge, index) => (
      <li class="grid overflow-clip rounded-md border border-neutral-content/15 bg-neutral-content/5 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
        <div class="min-w-0 p-6 sm:p-8">
          <p
            class="font-(family-name:--font-headers) text-4xl leading-none font-bold tracking-tight text-primary"
            aria-hidden="true"
          >
            {number(index)}.
          </p>
          <h3 class="mt-4 text-2xl leading-snug font-bold tracking-tight text-balance text-base-100">
            {challenge.problem}
          </h3>
          <p class="mt-3 max-w-md text-base leading-relaxed text-neutral-content/75">
            {challenge.symptom}
          </p>
        </div>
        <div class="min-w-0 bg-base-100 p-6 text-base-content sm:p-8">
          <p class="flex items-center gap-3 text-sm font-bold tracking-[0.16em] text-base-content/70 uppercase">
            <span class="h-0.5 w-6 shrink-0 bg-primary" aria-hidden="true"></span>
            How we'd respond
          </p>
          <p class="mt-4 max-w-2xl text-lg leading-relaxed text-pretty text-base-content">
            {challenge.response}
          </p>
        </div>
      </li>
    ))}
  </ol>
</DetailSection>
