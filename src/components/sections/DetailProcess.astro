---
import DetailSection from '@/components/sections/DetailSection.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import type { Engagement } from '@/data/detail-pages';

/**
 * The proposed engagement on a detail page, as four steps on the dark band of the home process,
 * lines and all: the baseline is Discovery, Plan, Build, Refine, with the labels adjusted to the
 * service or the industry. Each step is a card on the band, a shade lighter than it, with a large
 * primary Mukta number, then a title and what happens in it. Four share a row from lg and two
 * from md. It describes how a project would run, never work already done for a client. Plain HTML.
 */
interface Props {
  id: string;
  engagement: Engagement;
  /** The edge of this band the shared logo mark is centred on, if it carries one. */
  mark?: 'top' | 'bottom';
}

const { id, engagement, mark } = Astro.props;
const titleId = `${id}-title`;
const number = (index: number) => String(index + 1).padStart(2, '0');
---

<DetailSection id={id} labelledBy={titleId} tone="dark" mark={mark}>
  <SectionHeading
    id={titleId}
    eyebrow="How a project runs"
    heading={engagement.heading}
    intro={engagement.intro}
    tone="dark"
  />

  {/* role="list": Safari drops the list role from lists styled without markers. */}
  <ol role="list" class="mt-12 grid gap-5 sm:mt-14 md:grid-cols-2 lg:grid-cols-4 lg:gap-6">
    {engagement.steps.map((step, index) => (
      <li class="flex min-w-0 flex-col rounded-md border border-neutral-content/15 bg-neutral-content/5 p-6 sm:p-7">
        <p
          class="font-(family-name:--font-headers) text-5xl leading-none font-bold tracking-tight text-primary"
          aria-hidden="true"
        >
          {number(index)}.
        </p>
        <h3 class="mt-6 text-xl leading-snug font-bold tracking-tight text-balance text-base-100">
          <span class="sr-only">Step {index + 1}. </span>
          {step.title}
        </h3>
        <p class="mt-3 text-base leading-relaxed text-pretty text-neutral-content/80">
          {step.text}
        </p>
      </li>
    ))}
  </ol>
</DetailSection>
