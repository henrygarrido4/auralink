---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import type { Engagement } from '@/data/detail-pages';

/**
 * The proposed engagement on a detail page, as four steps on a `neutral` band: the baseline is
 * Discovery, Plan, Build, Refine, with the labels adjusted to the service or the industry. Each
 * step is a large Mukta number with a primary full stop, as the home process numbers its steps,
 * then a title and what happens in it. Four share a row from lg and two from md. It describes
 * how a project would run, never work already done for a client. Plain HTML.
 */
interface Props {
  id: string;
  engagement: Engagement;
}

const { id, engagement } = Astro.props;
const titleId = `${id}-title`;
const number = (index: number) => String(index + 1).padStart(2, '0');
---

<section id={id} aria-labelledby={titleId} class="bg-neutral text-neutral-content">
  <div class="mx-auto max-w-site px-6 py-16 sm:py-20 lg:px-8 lg:py-24">
    <SectionHeading
      id={titleId}
      eyebrow="How a project runs"
      heading={engagement.heading}
      intro={engagement.intro}
      tone="dark"
    />

    {/* role="list": Safari drops the list role from lists styled without markers. */}
    <ol role="list" class="mt-12 grid gap-x-8 gap-y-10 sm:mt-14 md:grid-cols-2 lg:grid-cols-4">
      {engagement.steps.map((step, index) => (
        <li class="min-w-0 border-t border-neutral-content/20 pt-6">
          {/* 3.2:1 against the band, as the home process's numbers are: enough for text this large. */}
          <p
            class="font-(family-name:--font-headers) text-5xl leading-none font-bold text-neutral-content/40"
            aria-hidden="true"
          >
            {number(index)}
            <span class="text-primary">.</span>
          </p>
          <h3 class="mt-5 text-xl font-bold tracking-tight text-balance text-base-100">
            <span class="sr-only">Step {index + 1}. </span>
            {step.title}
          </h3>
          <p class="mt-3 text-base leading-relaxed text-pretty text-neutral-content/80">
            {step.text}
          </p>
        </li>
      ))}
    </ol>
  </div>
</section>
