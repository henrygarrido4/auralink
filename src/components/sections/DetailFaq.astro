---
import DetailSection from '@/components/sections/DetailSection.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import type { FaqList } from '@/data/detail-pages';
import { contactRoutes } from '@/data/site';

/**
 * The questions prospective clients ask about the page's subject (four on a detail page, eleven
 * on the pricing page), as native disclosures, each a card: a `details` opens from the keyboard
 * (Enter or Space on its summary) and from a tap, with no script, and nothing animates. The
 * question is an h3 inside the summary, so the page's
 * outline lists it; at its right a plus sign drawn with two bars on a bordered disc turns into a
 * minus on a primary disc when the answer is open. From lg the heading, a sentence, and the link
 * to the contact page's "Send a message" tab (it invites a question, so it leads to the form) sit
 * in the left column with the questions beside them, starting level with the h2. An answer can
 * point to a page with a link under it, in the same style (the pricing page's question about
 * services beyond the packages, 2026-11-23). Core scope and deliverables stay outside these
 * disclosures, in the sections above. Plain HTML.
 */
interface Props {
  id: string;
  faqs: FaqList;
  /** The edge of this band the shared logo mark is centred on, if it carries one. */
  mark?: 'top' | 'bottom';
}

const { id, faqs, mark } = Astro.props;
const titleId = `${id}-title`;
---

<DetailSection id={id} labelledBy={titleId} mark={mark}>
  <div class="grid gap-10 lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:gap-16 xl:gap-24">
    <div class="min-w-0">
      <SectionHeading id={titleId} eyebrow="Questions" heading={faqs.heading} intro={faqs.intro} />
      <a
        href={contactRoutes.sendMessage}
        class="mt-6 inline-flex min-h-11 items-center gap-2 rounded-sm font-bold text-base-content underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral"
      >
        Ask something else
        <Icon name="arrow-right" class="size-4" />
      </a>
    </div>

    <div class="grid min-w-0 content-start gap-3 lg:pt-14">
      {faqs.items.map((faq) => (
        <details class="group detail-card">
          <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-6 px-5 py-4 text-left text-base-content marker:content-none hover:text-base-content/80 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-neutral sm:px-6 [&::-webkit-details-marker]:hidden">
            <h3 class="text-lg leading-snug font-bold tracking-tight text-balance">
              {faq.question}
            </h3>
            {/* A plus that becomes a minus: the upright bar hides while the answer is open. */}
            <span
              class="relative grid size-8 shrink-0 place-items-center rounded-full border border-base-300 text-base-content group-open:border-primary group-open:bg-primary"
              aria-hidden="true"
            >
              <span class="absolute inset-x-2 top-1/2 h-0.5 -translate-y-1/2 bg-current" />
              <span class="absolute inset-y-2 left-1/2 w-0.5 -translate-x-1/2 bg-current group-open:hidden" />
            </span>
          </summary>
          <p class="max-w-2xl px-5 pb-5 text-base leading-relaxed text-pretty text-base-content/80 sm:px-6">
            {faq.answer}
          </p>
          {/* A page the answer points to, in the style of the link beside the heading. */}
          {faq.link && (
            <div class="-mt-3 px-5 pb-3 sm:px-6">
              <a
                href={faq.link.href}
                class="inline-flex min-h-11 items-center gap-2 rounded-sm font-bold text-base-content underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral"
              >
                {faq.link.label}
                <Icon name="arrow-right" class="size-4" />
              </a>
            </div>
          )}
        </details>
      ))}
    </div>
  </div>
</DetailSection>
