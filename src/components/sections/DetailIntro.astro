---
import Eyebrow from '@/components/ui/Eyebrow.astro';
import type { Introduction } from '@/data/detail-pages';

/**
 * The first section of an industry or service detail page, straight under the dark hero: an
 * editorial split. The copy takes the wider column: the eyebrow, the h2, the primary rule, a
 * lead paragraph set larger (the answer first), then one or two short paragraphs at a readable
 * measure. Beside it from lg, and under it below, a quieter list says who the page is for, or when
 * the service fits: a heading and a few titled lines parted by hairline rules. Plain HTML.
 */
interface Props {
  /** Anchor for in-page links and the h2's id. */
  id: string;
  introduction: Introduction;
}

const { id, introduction } = Astro.props;
const titleId = `${id}-title`;
const asideId = `${id}-aside`;
---

<section id={id} aria-labelledby={titleId} class="bg-base-100">
  <div class="mx-auto max-w-site px-6 pt-16 pb-16 sm:pb-20 lg:px-8 lg:pt-20 lg:pb-24">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)] lg:gap-16 xl:gap-24">
      <div class="min-w-0">
        <Eyebrow>{introduction.eyebrow}</Eyebrow>
        <h2
          id={titleId}
          class="mt-4 text-3xl font-bold tracking-tight text-balance text-base-content sm:mt-5 sm:text-4xl"
        >
          {introduction.heading}
        </h2>
        <div class="mt-5 h-0.5 w-12 bg-primary" aria-hidden="true"></div>
        <p class="mt-6 max-w-2xl text-xl leading-relaxed text-pretty text-base-content">
          {introduction.lead}
        </p>
        {introduction.paragraphs.map((paragraph) => (
          <p class="mt-5 max-w-2xl text-lg leading-relaxed text-pretty text-base-content/80">
            {paragraph}
          </p>
        ))}
      </div>

      <div class="min-w-0 lg:pt-14">
        <h3 id={asideId} class="text-sm font-bold tracking-[0.16em] text-base-content/70 uppercase">
          {introduction.aside.heading}
        </h3>
        {/* role="list": Safari drops the list role from lists styled without markers. */}
        <ul role="list" aria-labelledby={asideId} class="mt-4 border-t border-base-300">
          {introduction.aside.items.map((item) => (
            <li class="grid gap-1 border-b border-base-300 py-4 sm:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] sm:gap-6">
              <p class="text-base leading-snug font-bold text-base-content">{item.title}</p>
              <p class="text-base leading-relaxed text-base-content/75">{item.text}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
