---
import Eyebrow from '@/components/ui/Eyebrow.astro';
import ProjectCard from '@/components/ui/ProjectCard.astro';
import { featuredProjects, workFilters } from '@/data/site';

/**
 * On no page since 2026-11-18, when the owner replaced it on the home page with "Who we work with"
 * (WhoWeWorkWith.astro). Kept, with its projects, photos, and props, for a later page.
 *
 * Home page selected work, after the services: a short introduction, filters by platform, and the
 * chosen platform's projects as cards numbered by their place in `featuredProjects`
 * (src/data/site.ts). The Hub2B theme's "Meet our hub space" section sets the look: a band in the
 * primary yellow, a heading in bold and light weights over a short white rule, and one large
 * white card at a time that pairs the copy with a 3:2 photo (ProjectCard.astro). Hub2B centres the
 * heading; here it is left-aligned, as in the site's other sections (owner, 2026-11-18).
 *
 * Hub2B steps through its spaces with slider arrows; here filters choose the project (owner,
 * 2026-11-18: "a filtering system ... instead of displaying them all at once", by platform), and
 * the section opens on the first. The filters are a native radio group styled as pills: Tab
 * reaches the group, the arrow keys move between options, and the `filter-group` utility shows
 * the chosen panel with no script, so they work without JavaScript. Every project stays in the
 * HTML. As in Hub2B, cut-out props pop out from behind the card as the section scrolls into view,
 * and again each time a filter shows another project (src/lib/reveal.ts, `pop-out`).
 */
interface Props {
  /** Anchor for in-page links. */
  id: string;
}

const { id } = Astro.props;
const titleId = `${id}-title`;

/** One panel per filter, holding its projects with their numbers. */
const panels = workFilters.map((filter) => ({
  ...filter,
  projects: featuredProjects.flatMap((project, index) =>
    project.service === filter.service ? [{ project, position: index + 1 }] : [],
  ),
}));
if (panels.length > 6) throw new Error('`filter-group` in global.css handles six filters at most');

/*
 * daisyUI's outline button in the near-black `secondary`, filled once chosen. Under the pointer an
 * unchosen pill only tints, so it never passes for the chosen one; every change is instant.
 */
const pill =
  'btn btn-outline btn-secondary rounded-full px-5 font-bold shadow-none transition-none active:translate-none hover:bg-secondary/10 hover:text-secondary has-checked:bg-secondary has-checked:text-secondary-content has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-secondary';
---

{/*
 * The bottom padding keeps the prop that drops below each card, and its shadow, on the band: 40% of
 * a prop up to 288px tall, plus about 30px of shadow.
 */}
<section id={id} aria-labelledby={titleId} class="bg-primary">
  <div class="filter-group mx-auto max-w-site px-6 pt-16 pb-20 sm:pt-20 sm:pb-24 lg:px-8 lg:pb-32 xl:pt-24 xl:pb-40">
    <div class="max-w-3xl">
      <Eyebrow>Selected work</Eyebrow>
      <h2
        id={titleId}
        class="mt-5 text-3xl font-bold tracking-tight text-balance text-base-content sm:text-4xl xl:text-5xl"
      >
        {/* The explicit space keeps the two lines apart in the heading's text. */}
        <span class="block">Different businesses.</span>{' '}
        <span class="block font-light">Different reasons to visit.</span>
      </h2>
      {/* Hub2B's rule under a heading on its yellow band is white. */}
      <div class="mt-6 h-0.5 w-24 bg-base-100" aria-hidden="true"></div>
      <p class="mt-6 max-w-2xl text-lg leading-relaxed text-pretty text-base-content/80">
        Three projects on three platforms: a custom static website for a barbershop, a WordPress
        website for an apartment community, and a Shopify recreation of an activewear store.
      </p>
    </div>

    <fieldset class="mt-8 min-w-0 sm:mt-10">
      <legend class="sr-only">Show the projects built with</legend>
      <div data-filter-options class="flex flex-wrap justify-center gap-2 sm:gap-3">
        {panels.map((panel, index) => (
          <label class={pill}>
            <input
              type="radio"
              name={`${id}-filter`}
              value={panel.service}
              checked={index === 0}
              class="sr-only"
            />
            {panel.label}
          </label>
        ))}
      </div>
    </fieldset>

    {/*
     * One panel per filter, in the filters' order, stacked in one grid cell; `filter-group` shows
     * the chosen one, and each card fills the panel. The gap above leaves room for the prop that
     * rises above each card's left end, clear of the pills: from 640px to lg the pills stretch
     * left far enough to meet it, so the gap grows there. The reveal starts when the panels
     * scroll in.
     */}
    <div data-filter-panels data-reveal class="mt-14 sm:mt-20 lg:mt-16">
      {panels.map((panel) => (
        <div>
          {/* role="list": Safari drops the list role from lists styled without markers. */}
          <ul role="list" class="grid h-full gap-24">
            {panel.projects.map(({ project, position }) => (
              <li class="h-full">
                <ProjectCard id={`${id}-${project.id}`} project={project} position={position} />
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { revealOnScroll } from '@/lib/reveal';

  revealOnScroll();
</script>
