---
import Button from '@/components/ui/Button.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Icon from '@/components/ui/Icon.astro';
import { privacyPage } from '@/data/privacy';
import { contactDetails, contactRoutes, industries, serviceCards } from '@/data/site';

/**
 * The project inquiry form on the contact page: a Netlify form, since 2026-11-20 the "Send a
 * message" panel of the page's two tabs (ContactOptions.astro), whose card and padding it sits in.
 * Its fields follow uprig.net/contact, the owner's reference (2026-11-19), with this studio's
 * services and kinds of business in place of that agency's trades. It asks for what qualifying an
 * inquiry needs and nothing more: a name and an email address, the business and an optional phone
 * number for the free call the site offers, the kind of business (`industries`), the services the
 * visitor is interested in (`serviceCards`, plus "Not sure yet", as several boxes rather than one
 * choice, since the studio offers email and search work alongside websites), the current website,
 * and the message. Only the name, the email address, and the message are required. The website
 * field takes any text, so "mybusiness.com" is not refused.
 *
 * The form posts without leaving the page (src/lib/inquiry-form.ts): the script validates it,
 * sends it to Netlify in the background, and swaps the panel to the confirmation below, which
 * takes focus and offers the booking tab as a next step. A failure shows the alert above the
 * button, with the studio's address and number, and keeps everything typed. Without JavaScript
 * the browser validates and posts it itself, and Netlify shows its own success page: there is no
 * thank-you page (owner, 2026-11-19). Should the visitor be on the other tab when an answer
 * arrives, the panel is `hidden`, so the focus the script asks for goes nowhere, and the
 * confirmation or the alert waits for them in the panel.
 *
 * Netlify reads the form from the built HTML, so keep `name`, `method`, `data-netlify`, the
 * honeypot, the hidden `form-name` input, and the field names, which label each submission in
 * Netlify's dashboard and notifications. Several boxes share the name `services`, which Netlify
 * lists as one field with every checked value.
 */

/**
 * The fields: 48px tall, the page's text size, a near-black focus ring (daisyUI's is the field's
 * own grey), and the theme's error red on the border once the script marks a field invalid.
 */
const control =
  'w-full bg-base-100 text-base focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary aria-[invalid=true]:border-error';
const input = `input h-12 ${control}`;
const label = 'text-sm font-bold text-base-content';
const hint = 'text-sm leading-relaxed text-base-content/70';
/** The message under an invalid field: the theme's dark error red, legible on the white card. */
const message = 'flex items-start gap-2 text-sm font-medium text-error-content';
/**
 * A service as a pill that holds its checkbox, bordered like the fields. The pill shows focus
 * (`has-focus-visible`), so the box itself draws no second ring; checked, both tint in the
 * primary yellow (`checkbox-primary` would also paint the box's border yellow while unchecked,
 * which is faint on white, so the border is the fields' grey until then).
 */
const pill =
  'flex min-h-12 cursor-pointer items-center gap-3 rounded-md border border-base-content/20 bg-base-100 px-4 py-2 font-medium text-base-content select-none hover:border-base-content/50 has-checked:border-primary has-checked:bg-primary/15 has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-secondary';
const checkbox =
  'checkbox checkbox-primary checkbox-sm rounded-sm border-base-content/20 checked:border-primary focus-visible:outline-none';
const focusRing =
  'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary';

/** The services a visitor can tick: the home page's service cards, and a way out of choosing. */
const interests = [...serviceCards.map((card) => card.title), 'Not sure yet'];
---

<div data-inquiry class="text-base-content">
  <form
    name="project-inquiry"
    method="POST"
    data-netlify="true"
    netlify-honeypot="company-website"
    data-inquiry-form
    class="grid gap-7"
  >
    <div>
      <Eyebrow>Project inquiry</Eyebrow>
      <h2 id="inquiry-title" class="mt-4 text-3xl font-bold tracking-tight text-balance">
        Start a conversation
      </h2>
      <div class="mt-4 h-0.5 w-12 bg-primary" aria-hidden="true"></div>
      <p class="mt-4 text-base leading-relaxed text-base-content/80">
        Share a few details and we'll take it from there. Fields marked with an asterisk (
        <span aria-hidden="true">*</span>) are required.
      </p>
    </div>

    {/* After the heading, so the panel opens with the eyebrow and the title, not two hidden fields. */}
    <input type="hidden" name="form-name" value="project-inquiry" />
    <p hidden>
      <label>
        Leave this empty: <input name="company-website" tabindex="-1" autocomplete="off" />
      </label>
    </p>

    <div class="grid gap-6 sm:grid-cols-2">
      <div class="grid gap-2">
        <label for="inquiry-name" class={label}>
          Your name <span aria-hidden="true">*</span>
        </label>
        <input
          id="inquiry-name"
          name="name"
          autocomplete="name"
          required
          data-required-message="Please enter your name."
          class={input}
        />
        <p id="inquiry-name-error" data-inquiry-error="name" hidden class={message}>
          <Icon name="circle-alert" class="mt-0.5 size-4 shrink-0" />
          <span data-inquiry-error-text></span>
        </p>
      </div>
      <div class="grid gap-2">
        <label for="inquiry-company" class={label}>
          Business name
        </label>
        <input id="inquiry-company" name="company" autocomplete="organization" class={input} />
      </div>
      <div class="grid gap-2">
        <label for="inquiry-email" class={label}>
          Email address <span aria-hidden="true">*</span>
        </label>
        <input
          id="inquiry-email"
          name="email"
          type="email"
          autocomplete="email"
          required
          data-required-message="Please enter your email address so we can reply."
          data-invalid-message="Please enter a valid email address, like name@example.com."
          class={input}
        />
        <p id="inquiry-email-error" data-inquiry-error="email" hidden class={message}>
          <Icon name="circle-alert" class="mt-0.5 size-4 shrink-0" />
          <span data-inquiry-error-text></span>
        </p>
      </div>
      <div class="grid gap-2">
        <label for="inquiry-phone" class={label}>
          Phone
        </label>
        <input id="inquiry-phone" name="phone" type="tel" autocomplete="tel" class={input} />
      </div>
    </div>

    <div class="grid gap-2">
      <label for="inquiry-industry" class={label}>
        What kind of business do you run?
      </label>
      <select id="inquiry-industry" name="industry" class={`select h-12 ${control}`}>
        <option value="">Choose one</option>
        {industries.map((industry) => (
          <option value={industry.name}>{industry.name}</option>
        ))}
        <option value="Other">Other</option>
      </select>
    </div>

    {/* `min-w-0`: a fieldset is otherwise as wide as its widest word and can push out of the card. */}
    <fieldset class="min-w-0">
      <legend class={label}>What are you interested in?</legend>
      <p class:list={['mt-1', hint]}>Choose as many as apply.</p>
      <div class="mt-3 flex flex-wrap gap-3">
        {interests.map((interest) => (
          <label class={pill}>
            <input type="checkbox" name="services" value={interest} class={checkbox} />
            {interest}
          </label>
        ))}
      </div>
    </fieldset>

    <div class="grid gap-2">
      <label for="inquiry-website" class={label}>
        Current website
      </label>
      <input
        id="inquiry-website"
        name="website"
        inputmode="url"
        autocomplete="url"
        placeholder="https://"
        class={input}
      />
    </div>

    <div class="grid gap-2">
      <label for="inquiry-message" class={label}>
        Tell us about your project <span aria-hidden="true">*</span>
      </label>
      <p id="inquiry-message-hint" class={hint}>
        What would you like to build or improve? A few sentences is plenty.
      </p>
      <textarea
        id="inquiry-message"
        name="message"
        rows="6"
        minlength="10"
        required
        aria-describedby="inquiry-message-hint"
        data-required-message="Please tell us a little about your project."
        data-invalid-message="Please tell us a little more: at least 10 characters."
        class={`textarea min-h-36 resize-y ${control}`}
      ></textarea>
      <p id="inquiry-message-error" data-inquiry-error="message" hidden class={message}>
        <Icon name="circle-alert" class="mt-0.5 size-4 shrink-0" />
        <span data-inquiry-error-text></span>
      </p>
    </div>

    {/* Shown by the script when the request fails; it takes focus, and the words stay in the fields. */}
    <div
      data-inquiry-alert
      role="alert"
      tabindex="-1"
      hidden
      class:list={[
        'flex items-start gap-3 rounded-md border border-error/30 bg-error/10 px-4 py-3',
        focusRing,
      ]}
    >
      <Icon name="circle-alert" class="mt-0.5 size-5 shrink-0 text-error-content" />
      <p class="text-base leading-relaxed">
        <strong class="font-bold">Your message couldn't be sent.</strong> Please check your
        connection and try again. Everything you typed is still here. You can also email us at{' '}
        <a
          href={contactDetails.emailHref}
          class:list={['rounded-sm font-bold break-all underline underline-offset-4', focusRing]}
        >
          {contactDetails.email}
        </a>{' '}
        or call{' '}
        <a
          href={contactDetails.phone.href}
          class:list={['rounded-sm font-bold underline underline-offset-4', focusRing]}
        >
          {contactDetails.phone.display}
        </a>
        .
      </p>
    </div>

    {/*
     * The site's primary button, lit, its aura in this card's dark text so it shows on white. The
     * script swaps the two labels while the form sends and ignores a second press meanwhile.
     */}
    <div class="flex flex-col gap-5 pt-1 sm:flex-row sm:items-center sm:gap-6">
      <Button
        type="submit"
        size="lg"
        aura="hover"
        data-inquiry-submit
        class="shrink-0 transition-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral"
      >
        <span data-inquiry-when="ready" class="contents">
          Send message
          <Icon name="arrow-right" class="size-5" />
        </span>
        <span data-inquiry-when="sending" hidden class="contents">
          Sending…
          <span class="loading loading-spinner loading-sm" aria-hidden="true"></span>
        </span>
      </Button>
      <p class={hint}>
        We use what you send only to respond to your inquiry. Our{' '}
        <a
          href={privacyPage.href}
          class:list={['rounded-sm underline underline-offset-4', focusRing]}
        >
          privacy policy
        </a>{' '}
        has the details.
      </p>
    </div>
  </form>

  {/*
   * The confirmation, in the form's place once Netlify has the message. It takes focus, so the
   * heading is read at once; the entrance is short and skipped under reduced motion. "Book a
   * free call" leads to the other tab (a fragment link, so the tabs script chooses it); "Send
   * another message" brings an empty form back.
   */}
  <div
    data-inquiry-success
    tabindex="-1"
    hidden
    class="rounded-md py-6 text-center duration-500 animate-in fade-in zoom-in-95 focus-visible:outline-2 focus-visible:outline-offset-8 focus-visible:outline-secondary sm:py-10"
  >
    <span
      class="mx-auto grid size-16 place-items-center rounded-full bg-primary text-primary-content"
      aria-hidden="true"
    >
      <Icon name="check" class="size-8" stroke-width="2.5" />
    </span>
    <h2 class="mt-6 text-3xl font-bold tracking-tight text-balance sm:text-4xl">Message sent.</h2>
    <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-pretty text-base-content/80">
      {/* `{' '}`: Astro drops a line break between text and an element, and the space with it. */}
      Thanks, <span data-inquiry-first-name class="font-bold text-base-content"></span>. We've
      received your message and will reply to{' '}
      <span data-inquiry-email class="font-bold wrap-break-word text-base-content"></span>.
    </p>
    <p class="mx-auto mt-3 max-w-xl text-base leading-relaxed text-base-content/70">
      If you'd rather talk it through, you can also book a free call.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <Button href={contactRoutes.bookCall} size="lg" variant="secondary" class="transition-none">
        Book a free call
        <Icon name="calendar-check" class="size-5" />
      </Button>
      <button
        type="button"
        data-inquiry-reset
        class:list={[
          'btn btn-lg btn-ghost rounded-full px-6 font-bold shadow-none transition-none',
          focusRing,
        ]}
      >
        Send another message
      </button>
    </div>
  </div>

  {/* Announces each step to assistive technology; the words are the script's. */}
  <p data-inquiry-status class="sr-only" aria-live="polite" aria-atomic="true"></p>
</div>

<script>
  import { enhanceInquiryForm } from '@/lib/inquiry-form';

  enhanceInquiryForm();
</script>
