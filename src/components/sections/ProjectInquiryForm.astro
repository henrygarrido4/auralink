---
import Button from '@/components/ui/Button.astro';
import { serviceCards } from '@/data/site';
const field =
  'input w-full bg-base-100 text-base focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary';
---

<form
  name="project-inquiry"
  method="POST"
  action="/contact/thank-you/"
  data-netlify="true"
  netlify-honeypot="company-website"
  class="grid gap-6"
>
  <input type="hidden" name="form-name" value="project-inquiry" />
  <p hidden>
    <label>
      Leave this empty: <input name="company-website" tabindex="-1" autocomplete="off" />
    </label>
  </p>
  <p class="text-base text-base-content/75">Fields marked with an asterisk (*) are required.</p>
  <div class="grid gap-6 sm:grid-cols-2">
    <div class="grid gap-2">
      <label for="inquiry-name" class="font-bold">
        Your name *
      </label>
      <input id="inquiry-name" name="name" autocomplete="name" required class={field} />
    </div>
    <div class="grid gap-2">
      <label for="inquiry-email" class="font-bold">
        Email address *
      </label>
      <input
        id="inquiry-email"
        name="email"
        type="email"
        autocomplete="email"
        required
        class={field}
      />
    </div>
    <div class="grid gap-2">
      <label for="inquiry-company" class="font-bold">
        Business name
      </label>
      <input id="inquiry-company" name="company" autocomplete="organization" class={field} />
    </div>
    <div class="grid gap-2">
      <label for="inquiry-website" class="font-bold">
        Website
      </label>
      <input
        id="inquiry-website"
        name="website"
        type="url"
        autocomplete="url"
        placeholder="https://"
        class={field}
      />
    </div>
  </div>
  <div class="grid gap-2">
    <label for="inquiry-service" class="font-bold">
      What can we help with?
    </label>
    <select
      id="inquiry-service"
      name="service"
      class="select w-full bg-base-100 text-base focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary"
    >
      <option value="">Select a service, or tell us below</option>
      {serviceCards.map((card) => (
        <option value={card.id}>{card.title}</option>
      ))}
      <option value="multiple">More than one service</option>
    </select>
  </div>
  <div class="grid gap-2">
    <label for="inquiry-message" class="font-bold">
      Tell us about your project *
    </label>
    <p id="inquiry-message-hint" class="text-base text-base-content/75">
      What would you like to build or improve?
    </p>
    <textarea
      id="inquiry-message"
      name="message"
      rows="6"
      minlength="10"
      required
      aria-describedby="inquiry-message-hint"
      class="textarea w-full resize-y bg-base-100 text-base focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary"
    ></textarea>
  </div>
  <div class="pt-2">
    <Button
      type="submit"
      size="lg"
      class="focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-secondary"
    >
      Send inquiry
    </Button>
  </div>
</form>
