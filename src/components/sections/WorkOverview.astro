---
import DetailSection from '@/components/sections/DetailSection.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { workPage, workProjects } from '@/data/work';

/**
 * The first section of the work page, after the "How to read these four" section of the Eyler
 * Creative results page the owner gave as the reference (2026-11-21): a heading and a sentence,
 * then the three parts every project is shown in, as numbered rows (the challenge, the solution,
 * what we manage). Beside them from lg, an index of the projects on the page: one card per project
 * with its number, name, platform, and kind of business, each a link to that project's section
 * further down, so a visitor can jump to the one most like their business. The index cards fade
 * in the service cards' 2px primary frame under the pointer (a pseudo-element, so nothing moves)
 * and take the near-black ring on keyboard focus. Plain HTML.
 */
interface Props {
  id: string;
}

const { id } = Astro.props;
const titleId = `${id}-title`;
const { overview } = workPage;
const number = (index: number) => String(index + 1).padStart(2, '0');

const frame =
  'before:pointer-events-none before:absolute before:-inset-px before:rounded-md before:border-2 before:border-primary before:opacity-0 before:transition-opacity before:duration-300 hover:before:opacity-100';
const focus =
  'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral focus-visible:before:opacity-100';
---

<DetailSection id={id} labelledBy={titleId}>
  <div class="grid gap-12 lg:grid-cols-12 lg:gap-x-12 xl:gap-x-16">
    <div class="min-w-0 lg:col-span-5">
      <SectionHeading
        id={titleId}
        eyebrow={overview.eyebrow}
        heading={overview.heading}
        intro={overview.intro}
      />
      {/* role="list": Safari drops the list role from lists styled without markers. */}
      <ol role="list" class="mt-10 border-t border-base-300">
        {overview.legend.map((part, index) => (
          <li class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-x-3 border-b border-base-300 py-5">
            <span
              class="font-(family-name:--font-headers) pt-0.5 text-sm leading-6 font-bold tracking-wide text-base-content/60"
              aria-hidden="true"
            >
              {number(index)}
            </span>
            <div class="min-w-0">
              <h3 class="text-lg leading-6 font-bold tracking-tight text-base-content">
                {part.title}
              </h3>
              <p class="mt-1.5 text-base leading-relaxed text-pretty text-base-content/75">
                {part.text}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    {/* Two across where the index sits under the legend; one column beside it from lg. */}
    <nav aria-label="Projects on this page" class="min-w-0 lg:col-span-7">
      <ol role="list" class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
        {workProjects.map((project, index) => (
          <li class="min-w-0">
            <a
              href={`#${project.id}`}
              class:list={[
                'detail-card relative flex h-full items-start gap-5 p-6 text-base-content',
                frame,
                focus,
              ]}
            >
              <span
                class="font-(family-name:--font-headers) text-3xl leading-none font-bold tracking-tight"
                aria-hidden="true"
              >
                {number(index)}
                <span class="text-primary">.</span>
              </span>
              <span class="min-w-0 flex-1">
                <span class="block text-xl leading-tight font-bold tracking-tight text-balance">
                  {project.name}
                </span>
                <span class="mt-2 block text-sm leading-snug text-base-content/70">
                  {project.platform} · {project.industry}
                </span>
              </span>
              <Icon name="arrow-right" class="mt-1 size-5 shrink-0 text-base-content/60" />
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>
</DetailSection>
