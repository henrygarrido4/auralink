---
import DetailSection from '@/components/sections/DetailSection.astro';
import BrowserFrame from '@/components/ui/BrowserFrame.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { workPage, workProjects } from '@/data/work';

/**
 * The first section of the work page, after the "How to read these four" section of the Eyler
 * Creative results page the owner gave as the reference (2026-11-21): a heading and a sentence,
 * then the three parts every project is shown in, as numbered rows (the challenge, the solution,
 * what we manage). Beside them from lg, an index of the projects on the page, two by two: since
 * the redesign of 2026-11-26 each entry is a thumbnail card (the research behind it, in the
 * studios' own galleries: the index sells the range, the pictures do the selling, the captions
 * stay small), the top of the project's homepage in a small browser window, then its number,
 * name, platform, and kind of business in one row with an arrow; below sm each is a row with the
 * window at its left, so four fit a phone's screen. Each card is one link to that project's
 * section further down, so a visitor can jump to the one most like their business.
 * The screenshot is decorative here (the card's text names the project; the project's section
 * carries the description) and grows by three percent inside its window under the pointer, as
 * the home cards' do, while the service cards' 2px primary frame fades in on the card's edge (a
 * pseudo-element, so nothing moves); keyboard focus adds the near-black ring. Plain HTML.
 */
interface Props {
  id: string;
}

const { id } = Astro.props;
const titleId = `${id}-title`;
const { overview } = workPage;
const number = (index: number) => String(index + 1).padStart(2, '0');

const frame =
  'before:pointer-events-none before:absolute before:-inset-px before:z-10 before:rounded-md before:border-2 before:border-primary before:opacity-0 before:transition-opacity before:duration-300 hover:before:opacity-100';
const focus =
  'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral focus-visible:before:opacity-100';
---

<DetailSection id={id} labelledBy={titleId}>
  <div class="grid gap-12 lg:grid-cols-12 lg:gap-x-12 xl:gap-x-16">
    <div class="min-w-0 lg:col-span-5">
      <SectionHeading
        id={titleId}
        eyebrow={overview.eyebrow}
        heading={overview.heading}
        intro={overview.intro}
      />
      {/* role="list": Safari drops the list role from lists styled without markers. */}
      <ol role="list" class="mt-10 border-t border-base-300">
        {overview.legend.map((part, index) => (
          <li class="grid grid-cols-[2.5rem_minmax(0,1fr)] gap-x-3 border-b border-base-300 py-5">
            <span
              class="font-(family-name:--font-headers) pt-0.5 text-sm leading-6 font-bold tracking-wide text-base-content/60"
              aria-hidden="true"
            >
              {number(index)}
            </span>
            <div class="min-w-0">
              <h3 class="text-lg leading-6 font-bold tracking-tight text-base-content">
                {part.title}
              </h3>
              <p class="mt-1.5 text-base leading-relaxed text-pretty text-base-content/75">
                {part.text}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    {/*
     * Rows below sm, the thumbnail at the left of each; cards two across from sm, under the
     * legend, and beside it from lg.
     */}
    <nav aria-label="Projects on this page" class="min-w-0 lg:col-span-7">
      <ol role="list" class="grid gap-4 sm:grid-cols-2 sm:gap-6">
        {workProjects.map((project, index) => (
          <li class="min-w-0">
            <a
              href={`#${project.id}`}
              class:list={[
                'group relative flex h-full rounded-md border border-base-300 bg-base-100 text-base-content shadow-sm sm:flex-col',
                frame,
                focus,
              ]}
            >
              {/*
               * `sizes`: two fifths of the row inside the container's padding (48px) below sm;
               * from sm the card's width, two across with the grid's gap (24px), in the 7/12
               * column from lg (its gap 48px, 64px from xl), capped by the 88rem container from
               * 1408px.
               */}
              <BrowserFrame
                project={project}
                crop="card"
                decorative
                sizes="(min-width: 1408px) 362px, (min-width: 1280px) calc((100vw - 128px) * 7 / 24 - 12px), (min-width: 1024px) calc((100vw - 112px) * 7 / 24 - 12px), (min-width: 640px) calc((100vw - 72px) / 2), calc((100vw - 48px) * 0.4)"
                class="w-2/5 shrink-0 rounded-l-md sm:w-auto sm:rounded-t-md sm:rounded-bl-none"
                imageClass="transition-transform duration-500 ease-out group-hover:scale-[1.03] group-focus-visible:scale-[1.03]"
              />
              <span class="flex min-w-0 flex-1 items-center gap-3 p-4 sm:items-start sm:p-5">
                <span
                  class="font-(family-name:--font-headers) text-lg leading-none font-bold tracking-tight text-base-content/60 sm:text-xl"
                  aria-hidden="true"
                >
                  {number(index)}
                  <span class="text-primary">.</span>
                </span>
                <span class="min-w-0 flex-1">
                  <span class="block text-base leading-tight font-bold tracking-tight text-balance sm:text-lg">
                    {project.name}
                  </span>
                  <span class="mt-1.5 block text-xs leading-snug text-base-content/70 sm:text-sm">
                    {project.platform} · {project.industry}
                  </span>
                </span>
                <Icon
                  name="arrow-right"
                  class="mt-0.5 hidden size-5 shrink-0 text-base-content/60 sm:block"
                />
              </span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  </div>
</DetailSection>
