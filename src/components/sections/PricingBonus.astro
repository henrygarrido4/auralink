---
import { welcomeSeries } from '@/data/pricing';

/**
 * The complimentary three-email welcome series on the pricing page (src/data/pricing.ts): a
 * primary band, like the home page's directory, so it reads as the extra that comes with Business
 * and Growth and not as a fourth package. The copy sits on the container's left edge: the eyebrow
 * opened by a near-black dash (the section heading's dash, in the band's own ink), the h2, the
 * lead, and the scope paragraph that says what the bonus covers and what it does not. Beside them
 * from lg, the three emails as white cards numbered on near-black discs. No price, no button, and
 * nothing moves. Plain HTML.
 */
interface Props {
  id: string;
}

const { id } = Astro.props;
const titleId = `${id}-title`;
---

<section id={id} aria-labelledby={titleId} class="bg-primary text-primary-content">
  <div class="mx-auto max-w-site px-6 py-16 sm:py-20 lg:px-8 lg:py-24">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,6fr)_minmax(0,6fr)] lg:items-center lg:gap-16 xl:gap-24">
      <div class="max-w-3xl min-w-0">
        <p class="flex items-center gap-3 text-sm font-bold tracking-[0.16em] uppercase">
          <span class="h-0.5 w-6 shrink-0 bg-neutral" aria-hidden="true"></span>
          {welcomeSeries.eyebrow}
        </p>
        <h2
          id={titleId}
          class="mt-5 text-3xl leading-tight font-bold tracking-tight text-balance sm:text-4xl lg:text-5xl"
        >
          {welcomeSeries.heading}
        </h2>
        <p class="mt-5 max-w-2xl text-lg leading-relaxed text-pretty">{welcomeSeries.lead}</p>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-pretty text-primary-content/80">
          {welcomeSeries.scope}
        </p>
      </div>

      {/* role="list": Safari drops the list role from lists styled without markers. */}
      <ol role="list" class="grid min-w-0 gap-4">
        {welcomeSeries.emails.map((email, index) => (
          <li class="flex items-start gap-5 rounded-md bg-base-100 p-5 text-base-content shadow-sm sm:p-6">
            <span
              class="grid size-11 shrink-0 place-items-center rounded-full bg-neutral font-(family-name:--font-headers) text-lg font-bold text-neutral-content"
              aria-hidden="true"
            >
              {index + 1}
            </span>
            <div class="min-w-0">
              <h3 class="text-lg leading-snug font-bold tracking-tight text-balance">
                <span class="sr-only">Email {index + 1}. </span>
                {email.title}
              </h3>
              <p class="mt-1 text-base leading-relaxed text-pretty text-base-content/75">
                {email.text}
              </p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
