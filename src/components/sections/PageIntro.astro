---
import Mark from '@/assets/aura-hero.svg';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/lib/icons';

/**
 * The hero of every page except the home page, which has its own (Hero.astro): a dark band
 * straight under the navbar, in the navbar's `neutral`, so the two read as one masthead. The
 * owner asked for it on 2026-11-19: a dark hero whose text mixes yellow and white, with the
 * logo's mark at a corner or side.
 *
 * The copy starts on the container's left edge like every other section, in this order: the
 * breadcrumbs, when the page has a parent (the industry and service detail pages, since the
 * owner's request of 2026-11-20): Home and the hub as links, the page itself as plain text marked
 * `aria-current`, in a breadcrumb landmark with decorative separators, wrapping on narrow screens;
 * the page's small outline icon from the site's set, when it has one, in the primary yellow; the
 * yellow eyebrow, which is the page's name as it appears in navigation (the owner's request of
 * 2026-11-20, replacing the fixed site name); the page's one `h1` in white with `highlight` in the
 * primary yellow; the short primary rule; the description in the band's light text; and, when a
 * page passes one, a short `note` under the description with a small primary icon (the pricing
 * page's two-week design preview, 2026-11-20, whose eyebrow is also the brief's own words rather
 * than the page's name). A title with no `highlight` is all white. Whatever a page puts in the
 * default slot follows, still in the copy column: the contact page's direct-contact links
 * (2026-11-20); every other page leaves it empty.
 *
 * The art is the mark the owner supplied (src/assets/aura-hero.svg), inlined at build time, so it
 * costs no request. It rests on the band's bottom edge at the right: beside the copy from lg, and
 * in a row of its own under the copy below lg, so it is never behind text. Behind it are a primary
 * glow and three rings centred on that edge, which cuts them in half, the home hero's orbit as a
 * sun on the horizon, and three pixels like the mark's own on the outer ring. All of it is
 * decorative and hidden from assistive technology.
 *
 * The `page-hero` utility (src/styles/global.css) holds the geometry and the motion; the classes
 * here are the paint. On load the glow fades in, the rings open, the mark rises into place, and
 * the pixels pop in, all within 2.3s. The copy never moves, and nothing moves under reduced
 * motion. No JavaScript.
 */
/** One step of the trail from the home page. The last step is the page itself and has no `href`. */
export interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  /** The small label above the title: the page's name as it appears in navigation. */
  eyebrow: string;
  title: string;
  /** The words of `title` to set in the primary yellow. They must occur in `title` as written. */
  highlight?: string;
  description: string;
  /** A short condition or caveat under the description, such as a delivery milestone. */
  note?: string;
  /** The page's own icon from the site's set, drawn small above the eyebrow. */
  icon?: IconName;
  /** The trail from the home page to this page, for pages with a parent hub. */
  breadcrumbs?: readonly Crumb[];
}

const { eyebrow, title, highlight, description, note, icon, breadcrumbs } = Astro.props;

const start = highlight ? title.indexOf(highlight) : -1;
if (highlight && start < 0) {
  throw new Error(`PageIntro: the highlight "${highlight}" is not part of the title "${title}".`);
}
if (breadcrumbs) {
  const last = breadcrumbs.length - 1;
  if (
    last < 1 ||
    breadcrumbs[last].href ||
    breadcrumbs.some((crumb, i) => i < last && !crumb.href)
  ) {
    throw new Error(
      'PageIntro: breadcrumbs need at least one linked parent and end with the current page, which has no href.',
    );
  }
}
/** The title in order, split around the highlight. Rendered back to back, so its text is `title`. */
const parts = (
  highlight
    ? [
        { text: title.slice(0, start), accent: false },
        { text: highlight, accent: true },
        { text: title.slice(start + highlight.length), accent: false },
      ]
    : [{ text: title, accent: false }]
).filter((part) => part.text);

/** From the centre outward. */
const rings = ['inner', 'middle', 'outer'] as const;
/** Where each sits on the outer ring is in the utility. The last is dimmer, as if further off. */
const pixels = [
  { place: 'left', paint: 'bg-primary' },
  { place: 'top', paint: 'bg-primary' },
  { place: 'right', paint: 'bg-primary/60' },
] as const;
---

<section aria-labelledby="page-title" class="page-hero bg-neutral text-neutral-content">
  {/* From lg the copy takes the room the art's column leaves; that column sets its own width. */}
  <div class="mx-auto grid max-w-site px-6 lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-x-12 lg:px-8">
    <div class="min-w-0 pt-16 pb-6 lg:py-20">
      {/*
       * The trail wraps on a narrow screen. Each link is at least 44px tall, so the row is a
       * comfortable target; the separator after a step is decorative and sits inside that step's
       * item, so the list counts only the steps. Hover and focus change at once, with no transition.
       */}
      {breadcrumbs && (
        <nav aria-label="Breadcrumb" class="mb-5">
          <ol class="flex flex-wrap items-center gap-x-3 text-sm font-bold tracking-[0.12em] uppercase">
            {breadcrumbs.map((crumb, index) => (
              <li class="flex min-h-11 items-center gap-3">
                {crumb.href ? (
                  <a
                    href={crumb.href}
                    class="inline-flex min-h-11 items-center rounded-sm text-neutral-content/80 underline decoration-neutral-content/40 underline-offset-4 hover:text-base-100 hover:decoration-primary focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
                  >
                    {crumb.label}
                  </a>
                ) : (
                  <span aria-current="page" class="text-base-100">
                    {crumb.label}
                  </span>
                )}
                {index < breadcrumbs.length - 1 && (
                  <span aria-hidden="true" class="text-neutral-content/60">
                    /
                  </span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )}
      {/* The page's icon, decorative: the eyebrow under it names the page. Stroke 1.5 of 24 at 40px. */}
      {icon && <Icon name={icon} class="size-10 text-primary" stroke-width="1.5" />}
      {/*
       * The shared eyebrow locks a dark colour for the light sections. Here the label is the
       * primary yellow, so it is set directly, with the same size and tracking.
       */}
      <p
        class:list={['text-sm font-bold tracking-[0.16em] text-primary uppercase', icon && 'mt-5']}
      >
        {eyebrow}
      </p>
      {/* White, like the logo's wordmark above it: the band's own light text is a shade greyer. */}
      <h1
        id="page-title"
        class="mt-5 text-5xl leading-tight font-bold tracking-tight text-balance text-base-100 sm:text-6xl"
      >
        {parts.map((part) =>
          part.accent ? <span class="text-primary">{part.text}</span> : part.text,
        )}
      </h1>
      <div class="mt-6 h-0.5 w-24 bg-primary" aria-hidden="true"></div>
      <p class="mt-6 max-w-3xl text-xl leading-relaxed text-pretty text-neutral-content/80">
        {description}
      </p>
      {note && (
        <p class="mt-5 flex max-w-3xl items-start gap-3 text-base leading-relaxed text-pretty text-neutral-content/75">
          <Icon name="circle-alert" class="mt-1 size-4 shrink-0 text-primary" />
          <span>{note}</span>
        </p>
      )}
      <slot />
    </div>

    <div data-page-hero-art aria-hidden="true">
      <div data-page-hero-disc>
        {/* A radial gradient reaches a square's corners, so 70% is the circle's edge. */}
        <span
          data-page-hero-glow
          class="rounded-full bg-radial from-primary/40 via-primary/15 via-40% to-transparent to-70%"
        ></span>
        {rings.map((ring) => (
          <span
            data-page-hero-ring={ring}
            class="rounded-full border border-neutral-content/15"
          ></span>
        ))}
        {pixels.map((pixel) => (
          <span data-page-hero-pixel={pixel.place} class={pixel.paint}></span>
        ))}
      </div>
      {/*
       * The file is used as supplied. Its artwork spans y 225.8 to 1274.2 of a 1500 square, so
       * this viewBox only trims the empty band above and below, and the mark can then be placed
       * by its own edges.
       */}
      <Mark
        data-page-hero-mark
        viewBox="0 225 1500 1050"
        width="1500"
        height="1050"
        focusable="false"
      />
    </div>
  </div>
</section>
