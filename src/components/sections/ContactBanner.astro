---
import { Picture } from 'astro:assets';
import workspace from '@/assets/contact/workspace.webp';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
---

{/* A separate closing section; the footer remains its own landmark and component. */}
<section
  id="project-contact"
  aria-labelledby="project-contact-title"
  class="relative isolate bg-neutral pt-48 text-neutral-content sm:pt-60 lg:pt-64"
>
  <div
    class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-64 overflow-hidden sm:h-80 lg:h-88"
    aria-hidden="true"
  >
    <Picture
      src={workspace}
      formats={['avif']}
      fallbackFormat="webp"
      quality={80}
      widths={[640, 1280, 1920]}
      sizes="100vw"
      alt=""
      loading="lazy"
      class="size-full object-cover object-center"
    />
    <div class="absolute inset-0 bg-neutral/25"></div>
  </div>
  <div class="mx-auto max-w-site px-6 lg:px-8">
    <div class="flex flex-col items-start gap-8 rounded-md bg-secondary px-7 py-10 text-secondary-content sm:px-10 sm:py-12 lg:flex-row lg:items-center lg:justify-between lg:gap-12 lg:px-14">
      {/*
       * `relative` keeps this copy above the button's glow. The aura takes this card's light text
       * colour, so it shows on the near-black fill, the same light as the navbar's primary button.
       */}
      <div class="relative">
        <p class="flex items-center gap-3 text-sm font-bold tracking-[0.18em] text-primary uppercase">
          <Icon name="message-circle" class="size-6 shrink-0" />
          Let's build what's next
        </p>
        <h2
          id="project-contact-title"
          class="mt-4 text-4xl leading-tight font-bold tracking-tight text-balance sm:text-5xl"
        >
          Have a project in mind?
        </h2>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-secondary-content/85">
          Professional websites built around your business, your customers, and your goals.
        </p>
      </div>
      {/*
       * The navbar's primary button: lit yellow, no icon. Its light stays off until the pointer or
       * keyboard focus, then circles and fades the same way (`aura="hover"`). The navbar keeps the
       * only lap that plays on load.
       */}
      <Button
        href="/contact/"
        size="lg"
        aura="hover"
        class="shrink-0 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-content"
      >
        Book a free call
      </Button>
    </div>
  </div>
</section>
