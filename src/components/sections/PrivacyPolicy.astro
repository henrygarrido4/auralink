---
import PolicyBlocks from '@/components/ui/PolicyBlocks.astro';
import { privacyIntro, privacySections } from '@/data/privacy';

/**
 * The privacy policy under the page's hero (src/pages/privacy/index.astro), one readable column
 * on the white page: the effective date and the answer in brief, a list of contents linking to
 * each section, then the sections, each a `section` named by its h2, with h3 parts where a
 * section has them. The copy is all in src/data/privacy.ts. No JavaScript, and nothing moves.
 */

const link =
  'rounded-sm underline decoration-base-content/30 decoration-1 underline-offset-4 hover:decoration-primary hover:decoration-2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral';
---

<div class="bg-base-100">
  <div class="mx-auto max-w-site px-6 py-16 sm:py-20 lg:px-8 lg:py-24">
    <div class="max-w-3xl">
      <PolicyBlocks blocks={privacyIntro} />

      <nav
        aria-labelledby="privacy-contents"
        class="mt-10 rounded-box border border-base-300 p-6 sm:p-8"
      >
        <h2 id="privacy-contents" class="text-xl leading-tight font-bold text-base-content">
          On this page
        </h2>
        <ol role="list" class="mt-5 grid gap-x-8 gap-y-3 sm:grid-cols-2">
          {privacySections.map((section) => (
            <li class="flex gap-3 text-base leading-relaxed text-base-content/80">
              <span class="mt-2.5 size-1.5 shrink-0 rotate-45 bg-primary" aria-hidden="true" />
              <a href={`#${section.id}`} class:list={['min-w-0', link]}>
                {section.heading}
              </a>
            </li>
          ))}
        </ol>
      </nav>

      {privacySections.map((section) => (
        <section id={section.id} aria-labelledby={`${section.id}-title`} class="mt-14">
          <h2
            id={`${section.id}-title`}
            class="text-2xl leading-tight font-bold tracking-tight text-balance text-base-content sm:text-3xl"
          >
            {section.heading}
          </h2>
          {section.blocks && <PolicyBlocks blocks={section.blocks} class="mt-4" />}
          {section.parts?.map((part) => (
            <Fragment>
              <h3 class="mt-8 text-xl leading-snug font-bold text-base-content">{part.heading}</h3>
              <PolicyBlocks blocks={part.blocks} class="mt-3" />
            </Fragment>
          ))}
        </section>
      ))}
    </div>
  </div>
</div>
