---
import Button from '@/components/ui/Button.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import ServiceCard from '@/components/ui/ServiceCard.astro';
import { serviceCards, servicesCta, servicesPageCards } from '@/data/site';
import { serviceCardLink } from '@/lib/service-cards';

/**
 * Home page services section, after the industry strip: a short introduction and one tile per entry
 * in `serviceCards` (src/data/site.ts). The Hub2B theme's "We care about visitors" section sets its
 * look and composition: a light grey band, white tiles in a four-column grid, and the introduction
 * inside that grid, in its top-left corner. Hub2B gives the introduction one cell and has seven
 * tiles; with six, the introduction takes the first two cells, so both rows stay full: it and two
 * tiles, then four tiles, the reference's second row. Below xl the introduction comes first, as
 * the reference stacks it, over two tiles per row from sm and one on phones. Hub2B centres its
 * introduction and tiles; here both are left-aligned at every width, like the site's other sections
 * (owner, 2026-11-18). Where Hub2B's introduction ends with a "Read more" button, ours ends with the
 * outlined secondary call to view all services (`servicesCta`), in near-black. Under
 * the pointer each tile shows Hub2B's hover, and the arrow box at its foot, placed as on the service
 * cards of Johnny's Exclusive Barbershop's website, fills with the primary colour as its arrow
 * slides through (ServiceCard.astro).
 * The first tile, Custom Websites, is the lead (owner, 2026-11-19): the same tile filled near-black,
 * with a yellow title, a white sentence, and the same 0.25rem arrow box, starting filled yellow.
 * High Scale Media's "What we do" cards inform only the action named beside the arrow, and only on a
 * tile that links to its own page ("Learn more"). A tile that still leads to the inquiry page names
 * no action (owner, 2026-11-19).
 * Each tile links to its service page, or to the inquiry page until that exists, or nowhere
 * (src/lib/service-cards.ts). No client-side JavaScript.
 *
 * The services page (`variant="page"`, owner 2026-11-19) keeps the heading: the eyebrow, the title,
 * and the rule. It drops the sentence and the button. Under that heading are the six home tiles
 * plus `servicesPageCards`, nine in all: one column on phones, two from sm, and three from lg.
 */
interface Props {
  /** Anchor for in-page links. */
  id: string;
  /** The services hub already is the destination of this link. */
  showCta?: boolean;
  /**
   * `home` is the band above. `page` is the services hub: the heading stays, the sentence does
   * not, and the tiles are three across.
   */
  variant?: 'home' | 'page';
}

const { id, showCta = true, variant = 'home' } = Astro.props;
const titleId = `${id}-title`;
const page = variant === 'page';
const cards = page ? [...serviceCards, ...servicesPageCards] : serviceCards;
---

{/*
 * The band is the reference's grey (#f4f4f4) from the theme: base-300 at 70% over the white page
 * gives #f3f3f3. base-200 (#f8f8f8) barely sets white tiles apart without borders; base-300 alone
 * (#eee) is darker than the reference.
 */}
<section id={id} aria-labelledby={titleId} class="bg-base-300/70">
  {/*
   * From xl one four-column grid holds the introduction and the list. The list spans both rows and
   * passes the grid's tracks to its items (subgrid), so tiles and introduction share row heights
   * and gaps. The first tile starts in column 3, beside the introduction, and the other five follow.
   * Built for six tiles: a seventh would need a new arrangement. The page variant does not use this
   * grid: the heading is a block above the list, and the list is three columns from lg.
   */}
  <div
    class:list={[
      'mx-auto max-w-site px-6 pt-16 pb-24 sm:pt-20 lg:px-8 xl:pt-18 xl:pb-40',
      !page && 'grid gap-12 xl:grid-cols-4 xl:gap-7.5',
    ]}
  >
    {/* `relative` keeps it above the list, which overlaps its cells from xl, so its text stays selectable. */}
    <div class:list={[!page && 'xl:relative xl:col-span-2 xl:col-start-1 xl:row-start-1 xl:pt-4']}>
      <Eyebrow>Our services</Eyebrow>
      <h2
        id={titleId}
        class="mt-5 text-3xl font-bold tracking-tight text-balance text-base-content sm:text-4xl xl:text-5xl"
      >
        {/* The explicit space keeps the two lines apart in the heading's text. */}
        <span class="block">Start with one service.</span>{' '}
        <span class="block font-light">Connect the rest.</span>
      </h2>
      <div class="mt-6 h-0.5 w-24 bg-primary" aria-hidden="true"></div>
      {!page && (
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-pretty text-base-content/80">
          Each service works on its own and is planned to fit with the others, so whatever you add
          next builds on what is already in place.
        </p>
      )}
      {/*
       * The large size, the same as the other page buttons. The outlined secondary is the hero's
       * "About us": transparent, with a near-black label and 1px border.
       */}
      {showCta && !page && (
        <div class="mt-8">
          <Button
            href={servicesCta.href}
            size="lg"
            variant="secondary"
            class="transition-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral"
          >
            {servicesCta.label}
          </Button>
        </div>
      )}
    </div>

    {/* role="list": Safari drops the list role from lists styled without markers. */}
    <ul
      role="list"
      class:list={[
        'grid gap-7.5',
        page
          ? 'mt-12 sm:mt-14 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3'
          : 'sm:grid-cols-2 xl:col-span-full xl:col-start-1 xl:row-span-2 xl:row-start-1 xl:grid-cols-subgrid xl:grid-rows-subgrid',
      ]}
    >
      {cards.map((card) => (
        <li class:list={[!page && 'xl:first:col-start-3']}>
          <ServiceCard
            id={`${id}-${card.id}`}
            title={card.title}
            description={card.description}
            icon={card.icon}
            link={serviceCardLink(card)}
            featured={card.id === 'custom-websites'}
          />
        </li>
      ))}
    </ul>
  </div>
</section>
