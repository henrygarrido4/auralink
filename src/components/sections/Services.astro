---
import Button from '@/components/ui/Button.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import ServiceCard from '@/components/ui/ServiceCard.astro';
import { serviceCards, servicesCta } from '@/data/site';
import { serviceCardLink } from '@/lib/service-cards';

/**
 * Home page services section, after the introduction: a short introduction and one tile per entry
 * in `serviceCards` (src/data/site.ts). The Hub2B theme's "We care about visitors" section sets its
 * look and composition: a light grey band, white tiles in a four-column grid, and the introduction
 * inside that grid, in its top-left corner. Hub2B gives the introduction one cell and has seven
 * tiles; with six, the introduction takes the first two cells, so both rows stay full: it and two
 * tiles, then four tiles, the reference's second row. Below xl the introduction comes first,
 * centred, as the reference stacks it, over two tiles per row from sm and one on phones. Where
 * Hub2B's introduction ends with a "Read more" button, ours ends with the primary call to view all
 * services (`servicesCta`), a placeholder until a page lists them. Under the pointer each tile shows
 * Hub2B's hover (ServiceCard.astro). High Scale Media's "What we do" cards inform only how a linked
 * tile shows it is a link. Each tile links to its service page, or to the inquiry page until that
 * exists, or nowhere (src/lib/service-cards.ts). No client-side JavaScript.
 */
interface Props {
  /** Anchor for in-page links. */
  id: string;
}

const { id } = Astro.props;
const titleId = `${id}-title`;
---

{/*
 * The band is the reference's grey (#f4f4f4) from the theme: base-300 at 70% over the white page
 * gives #f3f3f3. base-200 (#f8f8f8) barely sets white tiles apart without borders; base-300 alone
 * (#eee) is darker than the reference.
 */}
<section id={id} aria-labelledby={titleId} class="bg-base-300/70">
  {/*
   * From xl one four-column grid holds the introduction and the list. The list spans both rows and
   * passes the grid's tracks to its items (subgrid), so tiles and introduction share row heights
   * and gaps. The first tile starts in column 3, beside the introduction, and the other five follow.
   * Built for six tiles: a seventh would need a new arrangement.
   */}
  <div class="mx-auto grid max-w-site gap-12 px-6 pt-16 pb-24 sm:pt-20 lg:px-8 xl:grid-cols-4 xl:gap-7.5 xl:pt-18 xl:pb-40">
    {/* `relative` keeps it above the list, which overlaps its cells from xl, so its text stays selectable. */}
    <div class="text-center xl:relative xl:col-span-2 xl:col-start-1 xl:row-start-1 xl:pt-4 xl:text-left">
      <Eyebrow>Our services</Eyebrow>
      <h2
        id={titleId}
        class="mt-5 text-3xl font-bold tracking-tight text-balance text-base-content sm:text-4xl xl:text-5xl"
      >
        {/* The explicit space keeps the two lines apart in the heading's text. */}
        <span class="block">Start with one service.</span>{' '}
        <span class="block font-light">Connect the rest.</span>
      </h2>
      <div class="mx-auto mt-6 h-0.5 w-24 bg-primary xl:mx-0" aria-hidden="true"></div>
      <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-pretty text-base-content/80 xl:mx-0">
        Each service works on its own and is planned to fit with the others, so whatever you add
        next builds on what is already in place.
      </p>
      {/* The primary's aura shines in this text colour: dark, so it shows on the grey band. */}
      <div class="mt-8 text-base-content">
        <Button
          href={servicesCta.href}
          aura="hover"
          class="transition-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral"
        >
          {servicesCta.label}
        </Button>
      </div>
    </div>

    {/* role="list": Safari drops the list role from lists styled without markers. */}
    <ul
      role="list"
      class="grid gap-7.5 sm:grid-cols-2 xl:col-span-full xl:col-start-1 xl:row-span-2 xl:row-start-1 xl:grid-cols-subgrid xl:grid-rows-subgrid"
    >
      {serviceCards.map((card) => (
        <li class="xl:first:col-start-3">
          <ServiceCard
            id={`${id}-${card.id}`}
            title={card.title}
            description={card.description}
            icon={card.icon}
            link={serviceCardLink(card)}
          />
        </li>
      ))}
    </ul>
  </div>
</section>
