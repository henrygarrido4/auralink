---
import { Picture } from 'astro:assets';
import devices from '@/assets/hero/laptop-phone.webp';
import Button from '@/components/ui/Button.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import PencilUnderline from '@/components/ui/PencilUnderline.astro';
import ServiceOrbit from '@/components/ui/ServiceOrbit.astro';
import { primaryCta } from '@/data/site';

/**
 * Home page hero: positioning copy beside the laptop-and-phone image. The image is rendered from
 * the editable sources in design/hero-mockup/ (see its README). Two things move on load, once
 * each: the pencil underline under "brings them back", and the service icons, which swing into
 * place on a ring around the devices (ServiceOrbit; the owner's choice, 2026-11-18). After that
 * the icons travel only while a pointer is over the devices. The primary button's aura stays
 * unlit until the pointer or keyboard focus reaches it, then fades and circles like the navbar's.
 * When they leave it fades out and keeps its place, so the next visit continues from there. The
 * buttons themselves change colour at once, without transitions.
 */
interface Props {
  /** Target of the "About us" button. */
  aboutHref: string;
}

const { aboutHref } = Astro.props;

/**
 * Hover and focus change colour at once (no transition, no movement). The focus ring is the
 * near-black neutral: daisyUI's own ring takes the button colour, and yellow on this background
 * is 1.4:1.
 */
const buttonClass =
  'transition-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral';
---

<section aria-labelledby="hero-title" class="relative isolate bg-base-200">
  <div class="mx-auto flex max-w-site flex-col gap-12 px-6 pt-12 pb-20 sm:pt-16 sm:pb-24 lg:flex-row lg:items-center lg:px-8 lg:pb-28">
    {/* Copy takes about 45% of the row and the image 55%; flex-shrink absorbs the gap. */}
    <div class="min-w-0 lg:basis-9/20">
      <Eyebrow>Web design + lifecycle email</Eyebrow>
      {/*
       * Font size is 10% of the copy column's width, so "brings them back." stays on one line in
       * Mukta bold, the heading face (--font-headers). The column's width is written in viewport
       * units: 100vw - 3rem when stacked; 45% of (100vw - 4rem), less
       * its share of the 3rem gap, from lg; fixed from 1408px, the container's width, hence the
       * 3.645rem cap. The 1.5rem floor only applies below 288px. Change these with the container,
       * paddings, gap, or basis above.
       * (Container units would track the column by themselves, but they restyle the copy after
       * layout, which can start transitions on load.)
       * The bottom padding keeps the lifted underline clear of the paragraph below it.
       */}
      <h1
        id="hero-title"
        class="mt-5 pb-[0.1em] text-[clamp(1.5rem,calc(10vw-4.8px),3.5rem)] leading-[1.05] font-bold tracking-tight text-base-content lg:text-[clamp(2rem,calc(4.5vw-5.04px),3.645rem)]"
      >
        {/* One span per line; the explicit spaces keep the words apart in the heading's text. */}
        <span class="block">Websites that</span> <span class="block">win customers.</span>{' '}
        <span class="block">Email that</span>{' '}
        <span class="block">
          <span class="relative">
            <PencilUnderline />
            brings them back
          </span>
          .
        </span>
      </h1>
      <p class="mt-4 max-w-xl text-lg leading-relaxed text-base-content/80 sm:text-xl">
        Custom websites and email journeys that help people find you, choose you, and come back.
      </p>
      {/*
       * The primary's aura shines in this text colour: dark, so it shows on the light background.
       * `*:relative` makes the buttons paint in page order. The aura raises the primary above static
       * siblings, and About us must stay above the primary's glow, which reaches under its border.
       */}
      <div class="mt-10 flex flex-col gap-3 text-base-content *:relative sm:flex-row sm:items-center sm:gap-4">
        <Button href={primaryCta.href} size="lg" aura="hover" class={buttonClass}>
          {primaryCta.label}
        </Button>
        <Button href={aboutHref} size="lg" variant="secondary" class={buttonClass}>
          About us
        </Button>
      </div>
    </div>

    {/*
     * The service icons circle the devices. Their ring may use the room around the image, less
     * 12px above it (the 3rem gap under the buttons when stacked, the top padding from lg) and,
     * below it, less 36px of the bottom padding on phones and 20px from sm. Change these with
     * that gap and those paddings. The first icon rests 5 degrees past three o'clock and the
     * rest follow every 60. Only a narrow window, about 2 to 10 degrees, keeps every icon clear
     * of the laptop and the phone at every width. tests/e2e/hero.spec.ts checks it against the
     * image; a new image needs it tuned again.
     */}
    <ServiceOrbit
      start={5}
      class="mx-auto w-full max-w-2xl min-w-0 [--orbit-above:2.25rem] [--orbit-below:2.75rem] sm:[--orbit-below:4.75rem] lg:mx-0 lg:max-w-none lg:basis-11/20 lg:[--orbit-above:3.25rem] lg:[--orbit-below:5.75rem]"
    >
      <Picture
        src={devices}
        alt="Laptop and phone showing The Villas at Foxbrick homepage on desktop and mobile"
        formats={['avif']}
        fallbackFormat="webp"
        widths={[480, 640, 800, 1024, 1280, 1600]}
        sizes="(min-width: 1408px) 713px, (min-width: 1024px) calc(55vw - 62px), (min-width: 720px) 672px, calc(100vw - 48px)"
        loading="eager"
        fetchpriority="high"
        class="h-auto w-full"
      />
    </ServiceOrbit>
  </div>

  {/* Curved lower edge: the next section's background rises under the devices. */}
  <svg
    class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-12 w-full fill-base-100 sm:h-16 lg:h-24"
    viewBox="0 0 1440 96"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M0 96V66C260 96 640 104 1010 78C1200 64 1340 38 1440 6V96Z"></path>
  </svg>
</section>
