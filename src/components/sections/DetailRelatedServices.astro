---
import Icon from '@/components/ui/Icon.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { serviceCardById, type RelatedServices } from '@/data/detail-pages';

/**
 * The services an industry page recommends: three or four, each with why it matters for that kind
 * of business, on the grey band the home services use. Each is one link to its service page,
 * named by its visible text in order (the service, the reason, "Learn more"), as the home service
 * cards are. This section is the recommendation, not the catalogue: the services hub and the footer
 * list all six. Hover and focus change the tile's edge at once, with no transition. Plain HTML.
 */
interface Props {
  id: string;
  services: RelatedServices;
}

const { id, services } = Astro.props;
const titleId = `${id}-title`;
const items = services.items.map((entry) => ({ ...entry, card: serviceCardById(entry.card) }));
/** Three across for three, two by two for four, so no row is left short. */
const columns = items.length === 4 ? 'lg:grid-cols-2 xl:grid-cols-4' : 'lg:grid-cols-3';
---

<section id={id} aria-labelledby={titleId} class="bg-base-300/70">
  <div class="mx-auto max-w-site px-6 py-16 sm:py-20 lg:px-8 lg:py-24">
    <SectionHeading
      id={titleId}
      eyebrow="Where we help"
      heading={services.heading}
      intro={services.intro}
    />

    {/* role="list": Safari drops the list role from lists styled without markers. */}
    <ul role="list" class:list={['mt-12 grid gap-6 sm:mt-14 md:grid-cols-2', columns]}>
      {items.map(({ card, relevance }) => (
        <li class="min-w-0">
          <a
            href={card.href}
            class="group flex h-full flex-col rounded-md border border-base-300 bg-base-100 p-6 text-base-content hover:border-base-content/50 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral sm:p-8"
          >
            <span
              class="grid size-12 place-items-center rounded-md bg-primary text-primary-content"
              aria-hidden="true"
            >
              <Icon name={card.icon} class="size-6" />
            </span>
            <h3 class="mt-6 text-xl font-bold tracking-tight">{card.title}</h3>
            <p class="mt-3 text-base leading-relaxed text-pretty text-base-content/75">
              {relevance}
            </p>
            <span class="mt-auto flex items-center gap-2 pt-6 text-sm font-bold group-hover:underline group-hover:underline-offset-4">
              Learn more
              <Icon name="arrow-right" class="size-4" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
