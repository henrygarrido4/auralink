---
import Button from '@/components/ui/Button.astro';
import { primaryCta } from '@/data/site';

/**
 * The navbar's call to action for viewports below lg (owner, 2026-11-18), where the navbar keeps
 * its own inside the menu: a dark bar that stays at the bottom of the screen with the same button,
 * from `primaryCta` in src/data/site.ts. BaseLayout renders it last in the body, on every page.
 *
 * It is sticky, not fixed: it rests after the page's last content and sticks to the bottom edge
 * until the page scrolls that far, so it never covers the end of the page and needs no spacer.
 * `scroll-padding-bottom` in src/styles/global.css keeps focused content clear of it. Change that
 * value with this bar's height (the large button plus `py-3`).
 */
const focusRing =
  'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral-content';
---

{/* Clipped, so the button's glow stays inside the bar, as in the navbar. */}
<aside
  aria-label="Contact"
  class="sticky bottom-0 z-40 overflow-clip bg-neutral text-neutral-content lg:hidden print:hidden"
>
  {/* As in the hero: the button fills the row on phones and takes its own width from sm. */}
  <div class="mx-auto flex max-w-site flex-col px-6 py-3 sm:flex-row sm:justify-center">
    <Button href={primaryCta.href} size="lg" aura="hover" class={focusRing}>
      {primaryCta.label}
    </Button>
  </div>
</aside>
