---
import { Picture } from 'astro:assets';
import photo from '@/assets/about/business-owner-laptop.webp';
import Mark from '@/assets/aura-hero.svg';
import Button from '@/components/ui/Button.astro';
import Eyebrow from '@/components/ui/Eyebrow.astro';
import Icon from '@/components/ui/Icon.astro';
import { aboutCta, aboutHighlights, basedIn, owner, site } from '@/data/site';

/**
 * Home page introduction, after the process: who Auralink Studio works with and what it brings
 * together, beside the portrait the owner supplied. The hero's "About us" button opens the About
 * page itself (the owner, 2026-11-22), not this section.
 * The copy is laid out after the "What we offer" section the owner gave as the reference (a
 * screenshot, 2026-11-20): from lg it takes the wider column, the eyebrow, the heading, the rule,
 * the owner's paragraph, six points in two columns (`aboutHighlights`, each a mark, a title, and
 * one sentence), and the outlined secondary link to the About page (`aboutCta`) in near-black. The photo keeps the treatment
 * the owner preferred (2026-11-20), after the "Space for Freelancers and Creative People" section
 * of the Hub2B reference: from lg it sits left on a frame in the primary colour, offset down and
 * to the right; below lg the copy comes first and the photo follows. The reference's price and
 * guarantee have no place here: prices belong only on the pricing page. Nothing moves on its own, and there is no client-side JavaScript.
 *
 * The name card over the photo's lower right corner is the reference's, in this site's colours:
 * the name and the city under it (`basedIn`, with a decorative pin; the owner asked for the city
 * on the card, and for its "Founder" line off, 2026-11-22) on white, a hairline, and the owner's
 * mark on a near-black tile.
 * It renders only once `owner.name` is set in src/data/site.ts, as it is since the owner gave the
 * name in this section's copy (2026-11-22).
 *
 * The photo is the portrait the owner supplied on 2026-11-19, recorded in src/assets/CREDITS.md.
 * It is not captioned beyond that card, and it is not presented as a client or a testimonial.
 *
 * Since 2026-11-22 the copy is the owner's, in the first person beside the owner's photo: the
 * heading "Meet the developer behind your website.", and a paragraph that gives the owner's name,
 * the studio, and where it is based, the city the owner gave that day (`basedIn`) and asked to
 * have said here, above the projects, rather than in a section of its own. The six points stay.
 * The button says where it leads.
 */
interface Props {
  /** Anchor for in-page links. */
  id: string;
}

const { id } = Astro.props;
const titleId = `${id}-title`;
/** Who is speaking, where the studio is based. Without a name, the sentence still stands. */
const introduction = owner.name
  ? `I'm ${owner.name}, founder of ${site.name} in ${basedIn}.`
  : `I'm the founder of ${site.name} in ${basedIn}.`;
---

<section id={id} aria-labelledby={titleId}>
  <div class="mx-auto max-w-site px-6 pt-16 pb-20 sm:pt-20 sm:pb-24 lg:px-8 lg:pt-24 lg:pb-32">
    {/* One readable column below lg, aligned with the hero's copy; five and seven twelfths from lg. */}
    <div class="grid max-w-2xl gap-12 lg:max-w-none lg:grid-cols-[minmax(0,5fr)_minmax(0,7fr)] lg:items-center lg:gap-16 xl:gap-20">
      <div class="min-w-0">
        <Eyebrow>About Auralink Studio</Eyebrow>
        <h2
          id={titleId}
          class="mt-5 text-3xl font-bold tracking-tight text-balance text-base-content sm:text-4xl xl:text-5xl"
        >
          {/* The explicit space keeps the two lines apart in the heading's text. */}
          <span class="block">Meet the developer</span>{' '}
          <span class="block font-light">behind your website.</span>
        </h2>
        <div class="mt-6 h-0.5 w-24 bg-primary" aria-hidden="true"></div>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-base-content/80">
          {introduction} I design and build websites that help customers understand what you offer,
          see the quality of your work, and take the next step. That might mean booking an
          appointment, requesting a quote, or picking up the phone.
        </p>

        {/*
         * The six points, two columns from sm. Each opens with the check disc the "Why Auralink
         * Studio?" cards use (near-black, a yellow check), which is decorative: the title carries
         * the meaning. role="list": Safari drops the list role from lists styled without markers.
         */}
        <ul role="list" data-about-points class="mt-8 grid gap-x-8 gap-y-6 sm:mt-10 sm:grid-cols-2">
          {aboutHighlights.map((point) => (
            <li data-about-point class="flex min-w-0 items-start gap-4">
              <span
                class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-full bg-neutral text-primary"
                aria-hidden="true"
              >
                <Icon name="check" class="size-3.5" stroke-width="3" />
              </span>
              <div class="min-w-0">
                <h3 class="text-lg leading-snug font-bold tracking-tight text-base-content">
                  {point.title}
                </h3>
                <p class="mt-1 text-base leading-relaxed text-pretty text-base-content/70">
                  {point.description}
                </p>
              </div>
            </li>
          ))}
        </ul>

        {/*
         * The reference's spacing and size: 32px under the points on phones and 48px from md, with
         * an 18px label (lg). The outlined secondary is transparent, with a
         * near-black label and 1px border. The label names where it leads (the owner, 2026-11-22),
         * so it needs no hidden words.
         */}
        <div class="mt-8 md:mt-12">
          <Button
            href={aboutCta.href}
            size="lg"
            variant="secondary"
            class="transition-none focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral"
          >
            {aboutCta.label}
          </Button>
        </div>
      </div>

      {/*
       * The frame is the photo's size, shifted down and right by the padding that makes room for
       * it, and paints under the photo. The photo has its own positioned box, so the name card,
       * and a control placed over it later (the planned video, see docs/architecture.md), line up
       * with its edges.
       */}
      <div class="relative min-w-0 pr-4 pb-4 sm:pr-6 sm:pb-6 lg:order-first lg:pr-10 lg:pb-10 xl:pr-12 xl:pb-12">
        <div
          data-photo-frame
          class="absolute top-4 right-0 bottom-0 left-4 border-6 border-primary sm:top-6 sm:left-6 lg:top-10 lg:left-10 lg:border-8 xl:top-12 xl:left-12"
          aria-hidden="true"
        ></div>
        <div class="relative">
          {/*
           * `sizes` is the photo's rendered width at each breakpoint, worked out from the container
           * padding, the column split and gap, and the frame padding above: change it whenever they
           * change. The container is 88rem at most, reached at 1408px. Widths stop at the 1086px
           * source. The file is 1086×1168: 280px of empty wall is cropped from the top. Quality 80:
           * the image service's default AVIF quality is 50, which softened this portrait.
           */}
          <Picture
            src={photo}
            alt="Man with glasses sitting at a laptop, hands clasped, with a lamp and a plant behind him"
            formats={['avif']}
            fallbackFormat="webp"
            quality={80}
            widths={[480, 640, 800, 1086]}
            sizes="(min-width: 1408px) 479px, (min-width: 1280px) calc((100vw - 144px) * 5 / 12 - 48px), (min-width: 1024px) calc((100vw - 128px) * 5 / 12 - 40px), (min-width: 720px) 648px, (min-width: 640px) calc(100vw - 72px), calc(100vw - 64px)"
            class="block h-auto w-full"
          />
          {owner.name && (
            <div
              data-owner-card
              class="absolute right-4 bottom-4 flex max-w-[calc(100%-2rem)] items-center gap-4 rounded-lg bg-base-100 p-4 pr-5 text-base-content shadow-md sm:right-6 sm:bottom-6"
            >
              <div class="min-w-0">
                <p class="font-(family-name:--font-headers) text-lg leading-tight font-bold tracking-tight uppercase">
                  {owner.name}
                </p>
                {/* Where the studio is based, under the name (the owner, 2026-11-22). */}
                <p
                  data-owner-location
                  class="mt-1 flex items-center gap-1 text-sm leading-snug text-base-content/70"
                >
                  <Icon name="map-pin" class="size-3.5 shrink-0" />
                  {basedIn}
                </p>
              </div>
              <span class="h-10 w-px shrink-0 bg-base-300" aria-hidden="true"></span>
              <span
                class="grid size-11 shrink-0 place-items-center rounded-md bg-neutral"
                aria-hidden="true"
              >
                <Mark
                  class="h-6 w-auto"
                  viewBox="0 225 1500 1050"
                  width="1500"
                  height="1050"
                  focusable="false"
                />
              </span>
            </div>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
