---
import Icon from '@/components/ui/Icon.astro';

/**
 * The column beside the contact page's tabs, after uprig.net/contact, the owner's reference
 * (2026-11-19): what happens after a visitor books or writes, and where to look while still
 * deciding. White cards like the tabs' card, beside it from `xl`, in two columns from `md` and
 * one below. Plain HTML. The studio's address and number are not repeated here: they sit in the
 * page's hero (DirectContact.astro), in view whichever tab is chosen.
 *
 * The steps describe both ways in, from facts already approved: the call is the free 20-minute
 * one the booking tab offers (the owner, 2026-11-20), a message is read by the person who would
 * plan, design, and build the project (the "Personal partnership" pillar), the studio asks first
 * when something is unclear, and the third step is the owner's own sentence for the process's "A
 * clear plan" (docs/content-strategy.md), under the process section's titles, Free estimate and A
 * simple roadmap. None promises a response time, a price, or a result. The owner approved the
 * earlier three steps on 2026-11-19; the first two were reworded on 2026-11-20 to cover the call
 * as well as the message, and that wording awaits the owner's confirmation.
 */

/** In the order they happen, whichever way a visitor starts. */
const steps = [
  {
    title: 'You book a call or send a message',
    text: 'Booking puts a free 20-minute call on the calendar. A message is read by the person who would plan, design, and build your project.',
  },
  {
    title: 'We talk through your goals',
    text: "On the call, or in our reply to your message, we ask about anything that's unclear and talk through what you want to achieve.",
  },
  {
    title: 'You get a free estimate and a simple roadmap',
    text: "What we'd do first, what it costs, and what to expect. Nothing starts until you say yes.",
  },
];

/** Where to look before deciding: the hub pages the contact page already pointed to. */
const explore = [
  { label: 'Explore our services', href: '/services/' },
  { label: 'See who we work with', href: '/industries/' },
];

const card = 'rounded-md border border-base-300 bg-base-100 p-6 text-base-content shadow-sm sm:p-8';
const heading = 'text-xl font-bold tracking-tight';
const focusRing =
  'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary';
---

<aside aria-label="What to expect" class="grid content-start gap-6 md:grid-cols-2 xl:grid-cols-1">
  <div class={card}>
    <h2 class={heading}>What happens next</h2>
    {/* role="list": Safari drops the list role from lists styled without markers. */}
    <ol role="list" class="mt-6 grid gap-6">
      {steps.map((step, index) => (
        <li class="flex gap-4">
          <span class="grid size-9 shrink-0 place-items-center rounded-full bg-primary text-sm font-bold text-primary-content">
            {index + 1}
          </span>
          <div class="min-w-0">
            <h3 class="text-base leading-snug font-bold">{step.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-base-content/75">{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>

  <div class={card}>
    <h2 class={heading}>Still exploring?</h2>
    <p class="mt-2 text-sm leading-relaxed text-base-content/75">
      See what we do and who we work with, then come back whenever you're ready.
    </p>
    <ul role="list" class="mt-5 grid gap-3">
      {explore.map((link) => (
        <li>
          <a
            href={link.href}
            class:list={[
              'flex min-h-12 items-center justify-between gap-4 rounded-md border border-base-300 px-4 py-3 font-bold hover:border-base-content/40 hover:bg-base-200',
              focusRing,
            ]}
          >
            {link.label}
            <Icon name="arrow-right" class="size-5 shrink-0" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</aside>
