---
import type { Faq } from '@/data/detail-pages';
import { site } from '@/data/site';

/**
 * JSON-LD for an industry or service detail page, describing only what the page shows: the page
 * itself (a `Service` with the studio as provider, or a `WebPage` for an industry, whose
 * `audience` is that kind of business), the breadcrumb from the home page through the hub, and
 * the four visible questions and answers as a `FAQPage`. Facts about the studio come from
 * `site`; no rating, review, price, area served, or result is stated.
 */
interface Props {
  kind: 'service' | 'industry';
  /** The page's name: the service card's title, or the industry's name. */
  name: string;
  /** The meta description, so the markup and the head agree. */
  description: string;
  hub: { label: string; href: string };
  faqs: readonly Faq[];
}

const { kind, name, description, hub, faqs } = Astro.props;
const url = new URL(Astro.url.pathname, site.url).href;
const organization = { '@type': 'Organization', name: site.name, url: site.url };

const subject =
  kind === 'service'
    ? {
        '@type': 'Service',
        name,
        serviceType: name,
        description,
        url,
        provider: organization,
      }
    : {
        '@type': 'WebPage',
        name,
        description,
        url,
        isPartOf: { '@type': 'WebSite', name: site.name, url: site.url },
        about: organization,
        audience: { '@type': 'BusinessAudience', name },
      };

const breadcrumb = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: hub.label, item: new URL(hub.href, site.url).href },
    { '@type': 'ListItem', position: 3, name, item: url },
  ],
};

const faqPage = {
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: { '@type': 'Answer', text: faq.answer },
  })),
};

const schema = { '@context': 'https://schema.org', '@graph': [subject, breadcrumb, faqPage] };
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
