---
import BrowserFrame from '@/components/ui/BrowserFrame.astro';
import Icon from '@/components/ui/Icon.astro';
import { projectStatus, type WorkProject } from '@/data/work';

/**
 * One project as a card in the home page's selected work section (FeaturedWork.astro, the
 * owner's requests of 2026-11-21): the site's homepage in a browser window across the top, then
 * one row, with how it is built and that it is a concept over the name at the left and the
 * arrow box at the right. The owner asked for the cards to be much shorter than the first cut,
 * which carried a sentence and a "View project" label under the name: both went, so the card is
 * the screenshot and one row. The whole card is one link to the project's section on the work
 * page, named by its visible text (the platform, the status, the name), as the service cards that
 * lead to the inquiry page are named without an action word; the arrow is the action. The
 * screenshot has empty alt text here, since that text already names the project, and the work
 * page carries the screenshot's description.
 *
 * The card blends into the band (the owner, 2026-11-21): on the white band of 2026-11-22 it is
 * frosted white, 70% opaque over a blur, with a hairline and a soft shadow, so the band's yellow
 * aura tints it without muddying the text, with the light browser bar and the name in
 * near-black. The arrow box is the service tiles' (`arrow-box`; the owner, 2026-11-22, in place
 * of the lead tile's primary box): white, with a hairline edge, a small shadow, and a near-black
 * arrow, filling primary as the arrow slides through. Under the pointer and keyboard focus the
 * service cards' 2px primary frame fades in on the card's edge, the arrow box fills, and the
 * screenshot grows by three percent inside its window over 0.5s, which clips it, so nothing
 * around it moves. `scale` rests at the browser's own default, so the stylesheet's arrival
 * starts no transition in WebKit (`.cursor/rules/styling-tailwind-daisyui.mdc`). The frame is a
 * pseudo-element the stylesheet creates, so it transitions safely too. Reduced motion makes every
 * change instant. Keyboard focus adds a near-black ring 4px out, since the yellow alone is too
 * light on white.
 */
interface Props {
  project: WorkProject;
}

const { project } = Astro.props;

const frame =
  'before:pointer-events-none before:absolute before:-inset-px before:z-10 before:rounded-md before:border-2 before:border-primary before:opacity-0 before:transition-opacity before:duration-300 hover:before:opacity-100';
const focus =
  'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral focus-visible:before:opacity-100';
---

<a
  href={`/work/#${project.id}`}
  class:list={[
    'group relative flex h-full flex-col rounded-md border border-base-content/10 bg-base-100/70 text-base-content shadow-[0_1px_2px_rgb(0_0_0/0.04),0_12px_32px_-12px_rgb(0_0_0/0.14)] backdrop-blur-md',
    frame,
    focus,
  ]}
>
  {/*
   * `sizes`: the card's width inside the container's padding, one column below sm, two to lg,
   * three from lg, capped by the 88rem container from 1408px (three columns with two 32px gaps).
   */}
  <BrowserFrame
    project={project}
    crop="card"
    decorative
    sizes="(min-width: 1408px) 427px, (min-width: 1024px) calc((100vw - 128px) / 3), (min-width: 640px) calc((100vw - 72px) / 2), calc(100vw - 48px)"
    class="rounded-t-md"
    imageClass="transition-transform duration-500 ease-out group-hover:scale-[1.03] group-focus-visible:scale-[1.03]"
  />
  <div class="flex flex-1 items-center justify-between gap-4 p-5 sm:p-6">
    <div class="min-w-0">
      <p class="flex flex-wrap items-center gap-x-3 gap-y-1.5 text-xs font-bold tracking-[0.16em] text-base-content/70 uppercase">
        <span>{project.platform}</span>
        <span class="rounded-full border border-base-content/20 px-2.5 py-0.5 tracking-[0.12em]">
          {projectStatus}
        </span>
      </p>
      <h3 class="mt-2 text-xl leading-tight font-bold tracking-tight text-balance text-base-content sm:text-2xl">
        {project.name}
      </h3>
    </div>
    <span class="arrow-box size-12.5 shrink-0 rounded-sm shadow-md group-hover:arrow-box-active group-focus-visible:arrow-box-active">
      {/* The first arrow waits outside the box, to the left; the second rests in the box. */}
      <span data-arrow-track>
        <Icon name="arrow-right" class="size-5" />
        <Icon name="arrow-right" class="size-5" />
      </span>
    </span>
  </div>
</a>
