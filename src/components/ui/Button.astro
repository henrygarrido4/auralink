---
import type { HTMLAttributes } from 'astro/types';

/**
 * The site's call-to-action button. `primary` (the default) is daisyUI's `btn-primary`, pill-shaped,
 * with the lit, raised finish (`btn-lit` in src/styles/global.css); `secondary`, for the next-best
 * action beside a primary one, is a near-black pill outline on a transparent fill, which fills
 * near-black with a white label under the pointer. `neutral` is a flat near-black pill with a
 * light label, the same radius as the other buttons, for a call to action on the primary yellow,
 * where a yellow button would not stand out. A link by default; without an `href` it is a
 * placeholder for a page that has not shipped. Pass `type` to render a `<button>`.
 */
interface Props extends Omit<HTMLAttributes<'a'>, 'type'> {
  /** Renders a `<button>` of this type instead of a link. */
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  variant?: 'primary' | 'secondary' | 'neutral';
  size?: 'md' | 'lg';
  /** Fill the width of the container. */
  block?: boolean;
  /**
   * Wrap the button in daisyUI's border light (`aura`): one lap when the button appears, then light
   * only under the pointer or keyboard focus. `'hover'` skips the lap and leaves the light unlit
   * until then. Either way the light fades in and out, and once it has moved it continues from
   * where it stopped. Let at most one lap play per view.
   */
  aura?: boolean | 'hover';
}

const {
  type,
  variant = 'primary',
  size = 'md',
  block = false,
  aura = false,
  class: className,
  ...rest
} = Astro.props;

/**
 * daisyUI's outline in the theme's `secondary` gives the resting state (transparent, with the label
 * and a 1px border in `secondary`) and the filled one under the pointer, labelled white. The
 * utilities keep that fill and border at exactly `secondary`, which daisyUI darkens on hover, and
 * remove daisyUI's shadows and its half-pixel shift on press.
 */
const secondary =
  'btn-outline btn-secondary shadow-none text-shadow-none hover:border-secondary hover:bg-secondary active:translate-none';

/**
 * daisyUI's `btn-neutral`, kept flat: the same utilities remove its shadows, its text shadow, and
 * its half-pixel shift on press, and `bg-none` its noise texture, which the theme sizes to nothing
 * but the browser would still decode. `rounded-full` replaces daisyUI's `--radius-field` with the
 * pill the other variants use.
 */
const neutral = 'btn-neutral bg-none shadow-none text-shadow-none active:translate-none';

const variants = {
  primary: 'btn-primary btn-lit rounded-full',
  secondary: `${secondary} rounded-full`,
  neutral: `${neutral} rounded-full`,
};

const Tag = type ? 'button' : 'a';
const classes = [
  'btn font-bold',
  variants[variant],
  size === 'lg' ? 'btn-lg px-8' : 'px-6',
  block && 'btn-block',
  className,
];

/**
 * The aura's wrapper. `aura-lap` and `aura-hover` (src/styles/global.css) decide when its light
 * shows. The `'hover'` wrapper also takes no room of its own: a negative margin cancels the light's
 * padding, and as a grid it stretches the button whenever its parent stretches it (stacked hero
 * buttons). `isolate` keeps daisyUI's lift of the button (`z-index: 1`) inside the wrapper, so a
 * positioned sibling later in the page still paints above the button's glow.
 */
const auraClasses =
  aura === 'hover'
    ? ['aura aura-hover rounded-full -m-(--aura-padding) isolate', block ? 'grid' : 'inline-grid']
    : ['aura aura-lap rounded-full', block && 'block'];
---

{aura ? (
  <span class:list={auraClasses}>
    <Tag type={type} class:list={classes} {...rest}>
      <slot />
    </Tag>
  </span>
) : (
  <Tag type={type} class:list={classes} {...rest}>
    <slot />
  </Tag>
)}
