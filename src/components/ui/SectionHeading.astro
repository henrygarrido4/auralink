---
/**
 * The header of a detail-page section: the eyebrow, opened by a short primary dash (the mark of
 * the section labels on uprig.net/seo, the owner's reference for the detail pages' design pass,
 * 2026-11-20), the h2, and an optional introduction, left-aligned on the container's edge like
 * the home page's sections. The dash takes the place of the rule the home sections draw under
 * their headings, so each section opens with one accent, not two. `tone="dark"` is for a
 * `neutral` band: the label turns primary and the copy light, as the home process's does.
 */
interface Props {
  /** The h2's id, which the section's `aria-labelledby` names. */
  id: string;
  eyebrow: string;
  heading: string;
  intro?: string;
  tone?: 'light' | 'dark';
}

const { id, eyebrow, heading, intro, tone = 'light' } = Astro.props;
const dark = tone === 'dark';
---

<div class="max-w-3xl">
  <p
    class:list={[
      'flex items-center gap-3 text-sm font-bold tracking-[0.16em] uppercase',
      dark ? 'text-primary' : 'text-base-content/70',
    ]}
  >
    <span class="h-0.5 w-6 shrink-0 bg-primary" aria-hidden="true"></span>
    {eyebrow}
  </p>
  <h2
    id={id}
    class:list={[
      'mt-5 text-3xl leading-tight font-bold tracking-tight text-balance sm:text-4xl lg:text-5xl',
      dark ? 'text-base-100' : 'text-base-content',
    ]}
  >
    {heading}
  </h2>
  {intro && (
    <p
      class:list={[
        'mt-5 max-w-2xl text-lg leading-relaxed text-pretty',
        dark ? 'text-neutral-content/80' : 'text-base-content/80',
      ]}
    >
      {intro}
    </p>
  )}
</div>
