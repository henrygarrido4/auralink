---
import Icon from '@/components/ui/Icon.astro';
import type { JourneyBlock } from '@/data/detail-pages';

/**
 * A `journey` block of a detail page's module (src/data/detail-pages.ts): a workflow read as
 * steps, each a numbered mark, a small label (a trigger, an action, a stage), a title, and a
 * sentence or two. From md the steps share one row, joined by a hairline that runs from each
 * mark to the next; below md they stack. A note under the steps says that the journey is
 * illustrative, or what it depends on. The numbers are decorative: the list is ordered. Plain HTML.
 */
interface Props {
  block: JourneyBlock;
}

const { block } = Astro.props;
const count = block.steps.length;
const columns =
  count <= 3
    ? 'md:grid-cols-3'
    : count === 4
      ? 'md:grid-cols-2 lg:grid-cols-4'
      : 'md:grid-cols-3 lg:grid-cols-5';
---

<div>
  <div class="max-w-3xl">
    <h3 class="text-2xl font-bold tracking-tight text-balance text-base-content">
      {block.heading}
    </h3>
    {block.intro && (
      <p class="mt-3 text-base leading-relaxed text-pretty text-base-content/75">{block.intro}</p>
    )}
  </div>

  {/* role="list": Safari drops the list role from lists styled without markers. */}
  <ol role="list" class:list={['mt-8 grid gap-x-6 gap-y-8', columns]}>
    {block.steps.map((step, index) => (
      <li class="relative flex min-w-0 flex-col">
        <div class="flex items-center gap-4">
          <span
            class="grid size-10 shrink-0 place-items-center rounded-full bg-neutral font-(family-name:--font-headers) text-sm font-bold text-neutral-content"
            aria-hidden="true"
          >
            {index + 1}
          </span>
          {/* The line to the next step, across the grid's gap; the last step has none. */}
          {index < count - 1 && (
            <span class="hidden h-px flex-1 bg-base-300 md:block md:-mr-6" aria-hidden="true" />
          )}
        </div>
        <p class="mt-5 text-xs font-bold tracking-[0.16em] text-base-content/70 uppercase">
          {step.label}
        </p>
        <h4 class="mt-1 text-lg font-bold tracking-tight text-balance text-base-content">
          {step.title}
        </h4>
        <p class="mt-2 text-base leading-relaxed text-pretty text-base-content/75">{step.text}</p>
      </li>
    ))}
  </ol>

  {block.note && (
    <p class="mt-8 flex max-w-3xl items-start gap-3 text-sm leading-relaxed text-base-content/75">
      <Icon name="circle-alert" class="mt-0.5 size-4 shrink-0" />
      <span>{block.note}</span>
    </p>
  )}
</div>
