---
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/lib/icons';
import type { ServiceCardLink } from '@/lib/service-cards';

/**
 * One service as a tile from the Hub2B reference's "We care about visitors" section, which sets its
 * look: white, square-cornered, with no border or shadow, its icon drawn large in the primary colour
 * as a line icon, then its name (an h3) and a sentence, with generous padding above and below.
 * Hub2B centres them; here everything is left-aligned, as in the site's other sections (owner,
 * 2026-11-18). Plain utilities, not daisyUI's card: the reference has none of the card's radius,
 * padding, or title styles. Pure CSS, no JavaScript.
 *
 * Hover is Hub2B's too (owner, 2026-11-18): a 2px frame in the primary colour fades in on the tile's
 * edge over 300ms. It is a pseudo-element laid over the tile, so nothing moves or resizes. It shows
 * at once under reduced motion, and never on touch screens (Tailwind's `hover:` needs a hovering
 * pointer).
 *
 * Every tile ends with an arrow box. It began as the arrow of the service cards on Johnny's
 * Exclusive Barbershop's website (exclusivecutzz.netlify.app; `.card_btn` in its css/style.css),
 * the owner's own work, which the owner asked for (2026-11-18), and it keeps that arrow's place
 * and shape: a 50px box with 0.25rem corners. Its look and hover are this site's own, made when
 * the owner asked for a modern hover (2026-11-19; `arrow-box` in src/styles/global.css): white,
 * with a hairline edge, a small shadow, and a near-black arrow. Under the pointer the box fills
 * with the primary yellow over 0.3s, in step with the frame, while the arrow slides out to the
 * right and the same arrow slides in from the left. The arrow is near-black in both states
 * (19.9:1 on the white, 14.3:1 on the yellow) and never changes colour: an earlier fade from
 * yellow to near-black left a dark mark behind after the frame had gone, and the barbershop's own
 * swap, to a white arrow on the accent, is 1.4:1 with this yellow. Only the arrows move, inside
 * the box: the box and the tile stay where they are. The arrow shows before any hover, so touch
 * screens see it too. Every tile will lead to a page, so the arrow shows before that page exists
 * (owner, 2026-11-18), as the hero's button does.
 *
 * With a `link`, the whole tile is a single <a>. A label after the arrow names the action only when
 * the link has one ("Learn more" on a card's own page), the affordance from High Scale Media's
 * "What we do" cards. The inquiry fallback has no label (owner, 2026-11-19). The link takes its
 * accessible name from that visible text, in order: the service, the sentence, and the action when
 * one is shown. It is not set with aria-labelledby. Doing so either drops the sentence from the
 * name, or, when the sentence is included, axe still fails WCAG 2.5.3: its visible-text walk glues
 * the heading to the sentence ("WebsitesFast") while the name keeps the space. Keyboard focus shows
 * the frame, fills the arrow's box as its arrow slides through, and adds the near-black ring
 * the hero's buttons use, 4px out, inside the 30px gap: the yellow frame alone is too faint to mark
 * focus on a light tile, and on the lead tile the ring sits on the grey band, outside the near-black
 * fill. Without a link the tile has no label, is no tab stop, and keeps the default cursor
 * (src/lib/service-cards.ts).
 *
 * `featured` is the lead tile, Custom Websites (owner, 2026-11-19): the same square, borderless
 * tile, filled `neutral` instead of white, so it is the dark one in the row. The icon and the title
 * are `primary` and the sentence is `neutral-content` (white). Yellow on this near-black is the
 * inverse of the primary button's label, which clears the large-text minimum; the sentence uses the
 * neutral pair. Its arrow box is the same 50px square with 0.25rem corners as the others, and it
 * has no shadow: a grey shadow does not show on the near-black tile. The box starts filled
 * `primary` with a near-black arrow (`arrow-box-lead`), where the other cards arrive, and turns
 * white under the pointer as its arrow slides through (`arrow-box-lead-active`).
 */
interface Props {
  /** Unique on the page. The card's element id. */
  id: string;
  title: string;
  description: string;
  icon: IconName;
  link?: ServiceCardLink;
  /** Near-black lead tile. The home services section sets this on Custom Websites. */
  featured?: boolean;
}

const { id, title, description, icon, link, featured = false } = Astro.props;
const Tag = link ? 'a' : 'div';

/** Hub2B's hover: its frame, 2px in the primary colour, on the tile's edge, faded in. */
const frame =
  'before:pointer-events-none before:absolute before:inset-0 before:border-2 before:border-primary before:opacity-0 before:transition-opacity before:duration-300 hover:before:opacity-100';

const linkStates =
  'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral focus-visible:before:opacity-100';

/**
 * The arrow box. Its colours, its edge, and the slide come from `arrow-box`
 * (src/styles/global.css). A small shadow lifts it off the white tile, and its corners are
 * `rounded-sm` (0.25rem). The lead tile uses the same box, with `arrow-box-lead` for its colours
 * and no shadow.
 */
const arrowBox = [
  'arrow-box size-12.5 shrink-0 rounded-sm',
  featured
    ? 'arrow-box-lead group-hover:arrow-box-lead-active group-focus-visible:arrow-box-lead-active'
    : 'shadow-md group-hover:arrow-box-active group-focus-visible:arrow-box-active',
].join(' ');
---

<Tag
  id={id}
  href={link?.href}
  class:list={[
    'group relative flex h-full flex-col px-8 py-10 lg:py-16',
    featured ? 'bg-neutral text-neutral-content' : 'bg-base-100',
    frame,
    link && linkStates,
  ]}
>
  {/*
   * Lucide draws inside a 2px margin of its 24px grid, so a 96px icon shows an 80px glyph, the
   * reference's icon size. Stroke 1.2 of 24 draws 4.8px lines there, the weight of its line icons.
   * The margin is 8px at this size: the box starts that far left, so the drawing lines up with the
   * text.
   */}
  <Icon name={icon} class="-ml-2 size-24 text-primary" stroke-width="1.2" />
  <h3
    class:list={['mt-5 text-3xl font-bold tracking-tight text-balance', featured && 'text-primary']}
  >
    {title}
  </h3>
  <p
    class:list={[
      'mt-3 text-base leading-relaxed text-pretty',
      featured ? 'text-neutral-content' : 'text-base-content/80',
    ]}
  >
    {description}
  </p>
  <span class="mt-auto flex items-center gap-4 pt-8 text-sm font-bold">
    <span class={arrowBox}>
      {/*
       * The track `arrow-box` slides. In source order, the first arrow waits outside the box, to
       * the left, and the second is the one in the box at rest. Under the pointer the waiting
       * arrow takes its place.
       */}
      <span data-arrow-track>
        <Icon name="arrow-right" class="size-5" />
        <Icon name="arrow-right" class="size-5" />
      </span>
    </span>
    {link?.label}
  </span>
</Tag>
