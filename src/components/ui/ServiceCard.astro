---
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/lib/icons';
import type { ServiceCardLink } from '@/lib/service-cards';

/**
 * One service as a tile from the Hub2B reference's "We care about visitors" section, which sets its
 * look: white, square-cornered, with no border or shadow, its icon drawn large in the primary colour
 * as a line icon, then its name (an h3) and a sentence, all centred, with generous padding above and
 * below. Plain utilities, not daisyUI's card: the reference has none of the card's radius, padding,
 * or title styles. Pure CSS, no JavaScript.
 *
 * Hover is Hub2B's too (owner, 2026-11-18): a 2px frame in the primary colour fades in on the tile's
 * edge over 300ms. It is a pseudo-element laid over the tile, so nothing moves or resizes. It shows
 * at once under reduced motion, and never on touch screens (Tailwind's `hover:` needs a hovering
 * pointer).
 *
 * With a `link`, the whole tile is a single <a>. Only this link affordance comes from High Scale
 * Media's "What we do" cards. A label and an arrow name the action at the bottom and show before any
 * hover, so touch screens see them too. The link's name is the service and the action ("Custom
 * Websites Discuss this service"), and the sentence is its description. Under the pointer or keyboard
 * focus the frame shows and the arrow slides 4px toward its point, over 150ms, skipped under reduced
 * motion. Keyboard focus adds the near-black ring the hero's buttons use, 4px out, inside the 30px
 * gap: the yellow frame alone is too faint to mark focus. Without a link the tile has no label or
 * arrow and keeps the default cursor; the frame is decoration and leads nowhere
 * (src/lib/service-cards.ts).
 */
interface Props {
  /** Unique on the page; prefixes the ids that name and describe the link. */
  id: string;
  title: string;
  description: string;
  icon: IconName;
  link?: ServiceCardLink;
}

const { id, title, description, icon, link } = Astro.props;
const ids = { title: `${id}-title`, description: `${id}-description`, action: `${id}-action` };
const Tag = link ? 'a' : 'div';

/** Hub2B's hover: its frame, 2px in the primary colour, on the tile's edge, faded in. */
const frame =
  'before:pointer-events-none before:absolute before:inset-0 before:border-2 before:border-primary before:opacity-0 before:transition-opacity before:duration-300 hover:before:opacity-100';

const linkStates =
  'group focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-neutral focus-visible:before:opacity-100';
---

<Tag
  href={link?.href}
  aria-labelledby={link && `${ids.title} ${ids.action}`}
  aria-describedby={link && ids.description}
  class:list={[
    'relative flex h-full flex-col items-center bg-base-100 px-4 py-10 text-center lg:py-16',
    frame,
    link && linkStates,
  ]}
>
  {/*
   * Lucide draws inside a 2px margin of its 24px grid, so a 96px icon shows an 80px glyph, the
   * reference's icon size. Stroke 1.2 of 24 draws 4.8px lines there, the weight of its line icons.
   */}
  <Icon name={icon} class="size-24 text-primary" stroke-width="1.2" />
  <h3 id={link && ids.title} class="mt-5 text-3xl font-bold tracking-tight text-balance">
    {title}
  </h3>
  <p
    id={link && ids.description}
    class="mt-3 text-base leading-relaxed text-pretty text-base-content/80"
  >
    {description}
  </p>
  {link && (
    <span id={ids.action} class="mt-auto flex items-center gap-2 pt-6 text-sm font-bold">
      {link.label}
      <Icon
        name="arrow-right"
        class="size-5 motion-safe:transition-transform motion-safe:group-hover:translate-x-1 motion-safe:group-focus-visible:translate-x-1"
      />
    </span>
  )}
</Tag>
