---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/sections/PageIntro.astro';
import ProjectInquiryForm from '@/components/sections/ProjectInquiryForm.astro';
import PageSchema from '@/components/seo/PageSchema.astro';
---

<BaseLayout
  title="Contact"
  description="Tell Auralink Studio about your website, online store, email marketing, or search visibility project using the project inquiry form."
  showContactBanner={false}
>
  <Fragment slot="head">
    <PageSchema type="ContactPage" name="Contact Auralink Studio" />
  </Fragment>
  <PageIntro
    title="Let's talk about your project."
    highlight="your project."
    description="Websites and email marketing, built around your business."
  />
  <section
    aria-labelledby="inquiry-title"
    class="mx-auto grid max-w-site gap-10 px-6 pt-16 pb-20 lg:grid-cols-3 lg:gap-16 lg:px-8 lg:pt-20"
  >
    <div>
      <h2 id="inquiry-title" class="text-3xl font-bold">
        Start a conversation
      </h2>
      <p class="mt-4 text-lg leading-relaxed text-base-content/80">
        Tell us what you have in mind and which services you are interested in.
      </p>
      <div class="mt-6 flex flex-col items-start gap-3 font-bold">
        <a
          href="/services/"
          class="rounded-sm underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4"
        >
          Explore our services
        </a>
        <a
          href="/industries/"
          class="rounded-sm underline underline-offset-4 focus-visible:outline-2 focus-visible:outline-offset-4"
        >
          Who we work with
        </a>
      </div>
    </div>
    <div class="bg-base-200 p-6 sm:p-10 lg:col-span-2">
      <ProjectInquiryForm />
    </div>
  </section>
</BaseLayout>
