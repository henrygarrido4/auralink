---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/sections/PageIntro.astro';
import ProjectInquiryForm from '@/components/sections/ProjectInquiryForm.astro';
import ContactAside from '@/components/sections/ContactAside.astro';
import PageSchema from '@/components/seo/PageSchema.astro';

/*
 * Laid out after uprig.net/contact, the owner's reference (2026-11-19): the dark hero, then a
 * light band with the form in a white card and, beside it from lg, the shorter cards that say
 * what happens next and where to look first. The form confirms a sent message in place, so the
 * page is the whole inquiry: there is no thank-you page.
 */
---

<BaseLayout
  title="Contact"
  description="Tell Auralink Studio about your website, online store, email marketing, or search visibility project using the project inquiry form."
  showContactBanner={false}
>
  <Fragment slot="head">
    <PageSchema type="ContactPage" name="Contact Auralink Studio" />
  </Fragment>
  <PageIntro
    title="Let's talk about your project."
    highlight="your project."
    description="Tell us a little about your business and what you're looking for. Whether you need a new website, an online store, better email marketing, or more visibility in search, we're here to help."
  />
  <section aria-label="Project inquiry" class="bg-base-200">
    {/* The form takes the room the aside's column leaves; the aside keeps a readable width. */}
    <div class="mx-auto grid max-w-site gap-8 px-6 pt-16 pb-20 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,24rem)] lg:items-start lg:gap-10 lg:px-8 lg:pt-20 lg:pb-28 xl:gap-14">
      <ProjectInquiryForm />
      <ContactAside />
    </div>
  </section>
</BaseLayout>
