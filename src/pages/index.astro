---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import { site } from '../data/site';
---

<BaseLayout title={site.name} description={site.description}>
  <Hero aboutHref="#about" />
  <section id="about" aria-labelledby="about-title" class="mx-auto max-w-3xl px-6 py-24">
    <h2 id="about-title" class="text-3xl font-semibold tracking-tight">
      About {site.name}
    </h2>
    <p class="mt-6 text-lg leading-relaxed">{site.summary}</p>
  </section>
</BaseLayout>
