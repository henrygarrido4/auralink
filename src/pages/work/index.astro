---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageIntro from '@/components/sections/PageIntro.astro';
import WorkOverview from '@/components/sections/WorkOverview.astro';
import WorkProject from '@/components/sections/WorkProject.astro';
import DetailInvitation from '@/components/sections/DetailInvitation.astro';
import WorkPageSchema from '@/components/seo/WorkPageSchema.astro';
import { checkPageHead } from '@/data/detail-pages';
import { workPage, workProjects } from '@/data/work';

/*
 * The work page (the owner's brief, 2026-11-21): what is said about each project follows
 * https://eylercreative.com/results/ (the challenge, the solution, what we manage), and how the
 * projects are shown is the redesign of 2026-11-26 (the owner asked for a modern page, with the
 * hero kept), in this site's own system: the shared dark hero; how to read the projects, with an
 * index of thumbnail cards; one section per project, a showcase panel (charcoal and white in
 * turn, the browser-framed screenshot beside the copy, swapping sides, the three features across
 * its foot) over the story in three columns; the invitation; then the shared contact banner. The
 * reference's results figures are left out on purpose: the owner has none to publish, so each
 * project shows the thinking and the build instead. Every project is in `workProjects`
 * (src/data/work.ts), which the home page's three cards also read.
 */
checkPageHead({ slug: 'work', ...workPage });
---

<BaseLayout title={workPage.metaTitle} description={workPage.metaDescription}>
  <Fragment slot="head">
    <WorkPageSchema description={workPage.metaDescription} />
  </Fragment>
  <PageIntro
    eyebrow="Work"
    title={workPage.title}
    highlight={workPage.highlight}
    description={workPage.description}
  />
  <WorkOverview id="overview" />
  {workProjects.map((project, index) => (
    <WorkProject project={project} index={index} />
  ))}
  <DetailInvitation id="next-step" invitation={workPage.invitation} />
</BaseLayout>
