---
import { Font } from 'astro:assets';
import '../styles/global.css';
import faviconSvg from '../../public/favicon.svg?raw';
import Navbar from '../components/sections/Navbar.astro';
import ContactBanner from '../components/sections/ContactBanner.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import { site } from '../data/site';

/**
 * The SVG favicon, written into the head as a data URL instead of linked (2026-11-22). Chrome
 * asks for the icon as soon as the page has loaded, which on these pages is before the hero has
 * been shown, and Lighthouse's simulation then counts that request toward First and Largest
 * Contentful Paint: about 75 ms of the home page's LCP under mobile throttling, on top of the
 * round trip the request costs a visitor. Inlined, there is no request; the page carries 1.5 KB
 * more compressed. The file itself stays in public/ for anything that asks for it by path, and
 * the ICO beside it still serves browsers without SVG icons. Read at build time from the file
 * design/favicon/render.mjs writes, so redrawing the icon changes both. Quotes become single so
 * the URL can sit in a double-quoted attribute; the rest is what a URL cannot carry as it is.
 */
const faviconDataUrl = `data:image/svg+xml,${faviconSvg
  .trim()
  .replace(/"/g, "'")
  .replace(/%/g, '%25')
  .replace(/#/g, '%23')
  .replace(/</g, '%3C')
  .replace(/>/g, '%3E')
  .replace(/\s+/g, ' ')}`;

interface Props {
  /** Page title without the site name. Use the site name itself only on the home page. */
  title: string;
  /** 50-160 characters. Shown in search results and link previews. */
  description: string;
  /** Override the canonical URL only for intentional duplicates. */
  canonical?: string;
  /** Absolute or root-relative path to a 1200x630 image. */
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Keep a page out of search engines (drafts, thank-you pages). */
  noindex?: boolean;
  /** Closing banner is separate from the footer; omit on the inquiry and success pages. */
  showContactBanner?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage,
  ogType = 'website',
  noindex = false,
  showContactBanner = true,
} = Astro.props;

const fullTitle = title === site.name ? site.name : `${title} | ${site.name}`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site ?? site.url).href : undefined;
---

<!doctype html>
<html lang={site.language} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="only light" />
    {/*
      Google Tag Manager, container GTM-PVBR2FJZ (the owner's decision, 2026-11-21): the
      `dataLayer` and `gtag()` lines of Google's install snippet as given, `is:inline` so Astro
      leaves the script as it is and `gtag` stays global, and `arguments` kept as written, since
      gtag.js tells its commands from other dataLayer pushes by that object (eslint.config.js lifts
      prefer-rest-params for this file's scripts). The container script is not in the markup: it
      is added at the visitor's first pointer movement, press, key, touch, or scroll, or three
      seconds after `load`, whichever comes first (the owner's decision, 2026-11-22), so that it,
      and the GA4 and Meta scripts it loads on the live site, about 500 KB in all, no longer arrive
      before the hero image is shown and count toward its LCP in PageSpeed Insights, which never
      moves a pointer. Pushes made before then, the lead signal among them
      (src/lib/lead-tracking.ts), wait in the array and are read when the container loads. Tags,
      the Meta pixel's base code included, are configured in the container, not here
      (docs/architecture.md, "Analytics").
    */}
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      (() => {
        const wake = ['mousemove', 'pointerdown', 'keydown', 'touchstart', 'scroll'];
        let loaded = false;
        const loadTagManager = () => {
          if (loaded) return;
          loaded = true;
          wake.forEach((type) => window.removeEventListener(type, loadTagManager));
          const script = document.createElement('script');
          script.async = true;
          script.src = 'https://www.googletagmanager.com/gtm.js?id=GTM-PVBR2FJZ';
          document.head.appendChild(script);
        };
        wake.forEach((type) =>
          window.addEventListener(type, loadTagManager, { once: true, passive: true }),
        );
        window.addEventListener('load', () => setTimeout(loadTagManager, 3000));
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={site.locale} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <link rel="icon" type="image/svg+xml" href={faviconDataUrl} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    {/*
      Above-the-fold weights only: Catamaran regular (body) and bold (nav, buttons), Mukta bold
      (the h1). Mukta light is the second line of later headings, so it waits for the stylesheet.
    */}
    <Font cssVariable="--font-main" preload={[{ weight: 400 }, { weight: 700 }]} />
    <Font cssVariable="--font-headers" preload={[{ weight: 700 }]} />
    <slot name="head" />
  </head>
  <body id="top" class="bg-base-100 text-base-content min-h-screen antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-base-100 focus:px-4 focus:py-2 focus:shadow"
    >
      Skip to main content
    </a>
    <slot name="header">
      <Navbar />
    </slot>
    <main id="main-content" tabindex="-1">
      <slot />
      {showContactBanner && <ContactBanner />}
    </main>
    <slot name="footer">
      <SiteFooter />
    </slot>
  </body>
</html>
