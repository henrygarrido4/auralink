---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Navbar from '../components/sections/Navbar.astro';
import StickyCta from '../components/sections/StickyCta.astro';
import ContactBanner from '../components/sections/ContactBanner.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import { site } from '../data/site';

interface Props {
  /** Page title without the site name. Use the site name itself only on the home page. */
  title: string;
  /** 50-160 characters. Shown in search results and link previews. */
  description: string;
  /** Override the canonical URL only for intentional duplicates. */
  canonical?: string;
  /** Absolute or root-relative path to a 1200x630 image. */
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Keep a page out of search engines (drafts, thank-you pages). */
  noindex?: boolean;
  /** Closing banner is separate from the footer; omit on the inquiry and success pages. */
  showContactBanner?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage,
  ogType = 'website',
  noindex = false,
  showContactBanner = true,
} = Astro.props;

const fullTitle = title === site.name ? site.name : `${title} | ${site.name}`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site ?? site.url).href;
const ogImageUrl = ogImage ? new URL(ogImage, Astro.site ?? site.url).href : undefined;
---

<!doctype html>
<html lang={site.language} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="only light" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={site.locale} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    {/*
      Above-the-fold weights only: Catamaran regular (body) and bold (nav, buttons), Mukta bold
      (the h1). Mukta light is the second line of later headings, so it waits for the stylesheet.
    */}
    <Font cssVariable="--font-main" preload={[{ weight: 400 }, { weight: 700 }]} />
    <Font cssVariable="--font-headers" preload={[{ weight: 700 }]} />
    <slot name="head" />
  </head>
  <body id="top" class="bg-base-100 text-base-content min-h-screen antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-base-100 focus:px-4 focus:py-2 focus:shadow"
    >
      Skip to main content
    </a>
    <slot name="header">
      <Navbar />
    </slot>
    <main id="main-content" tabindex="-1">
      <slot />
      {showContactBanner && <ContactBanner />}
    </main>
    <slot name="footer">
      <SiteFooter />
    </slot>
    <StickyCta />
  </body>
</html>
