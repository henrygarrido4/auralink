{
  "name": "auralink-agency",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:bg": "astro dev --background",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "check:vue": "vue-tsc --noEmit",
    "check:workflow": "node scripts/verify-workflow.mjs",
    "check:content": "node scripts/check-content.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "quality:static": "npm run check:workflow && npm run check:content && npm run format:check && npm run lint && npm run check && npm run check:vue",
    "quality": "npm run quality:static && npm run test:e2e",
    "test:e2e:chromium": "playwright test --project=desktop-chromium --project=mobile-chromium",
    "perf:audit": "node scripts/perf-audit.mjs",
    "perf:audit:quick": "node scripts/perf-audit.mjs --no-build --runs=1",
    "quality:full": "npm run quality:static && npm run build && PLAYWRIGHT_SKIP_BUILD=1 playwright test && node scripts/perf-audit.mjs --no-build"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.5",
    "@astrojs/vue": "^7.1.6",
    "@inspira-ui/plugins": "^0.0.2",
    "@tailwindcss/vite": "^4.3.5",
    "@vueuse/core": "^15.0.0",
    "astro": "^7.4.12",
    "clsx": "^2.1.1",
    "daisyui": "^5.8.1",
    "motion-v": "^2.12.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "lighthouse": "^13.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vue-tsc": "^3.3.14"
  }
}
